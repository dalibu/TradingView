// ═══════════════════════════════════════════════════════════════
// 📦 TYPE DEFINITIONS
// ═══════════════════════════════════════════════════════════════
type fvg
    box   boxObject
    line  midLine
    float top
    float bottom
    bool  filled
    int   startCheck
    bool  bullish

type ifvg
    box   boxObject
    line  midLine
    float top
    float bottom
    bool  filled
    int   startCheck
    bool  bullish

type orderBlock
    box   boxObject
    line  midLine
    float top
    float bottom
    bool  filled
    int   startCheck
    bool  bullish
    int   originBar

