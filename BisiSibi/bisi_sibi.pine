//@version=6
indicator("[ArtiShock] BISI SIBI OB + Killzones + Liquidity Levels + BoS/CHoCH + FVG + IFVG 2026",
     overlay=true,
     max_bars_back=5000,
     max_boxes_count=1000,
     max_lines_count=500,
     max_labels_count=500)

const string POSITION_LEFT = "Left"
const string POSITION_RIGHT = "Right"
const string TIME_ZONE = "America/New_York"

// ═══════════════════════════════════════════════════════════════
// 🛠 GENERAL SETTINGS
// ═══════════════════════════════════════════════════════════════
generalSettings = "═══════ GENERAL SETTINGS ═══════"

lookbackBars = input.int(
     group=generalSettings,
     defval=5000,
     title="Lookback Bars",
     minval=1,
     maxval=50000)

