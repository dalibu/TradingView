//@version=6
indicator("BISI SIBI OB + Killzones + Liquidity Levels + BOS/CHoCH",
     overlay=true,
     max_bars_back=5000,
     max_boxes_count=1000,
     max_lines_count=500,
     max_labels_count=500)

// ═══════════════════════════════════════════════════════════════
// 🛠 GENERAL SETTINGS
// ═══════════════════════════════════════════════════════════════
generalSettings = "═══════ GENERAL SETTINGS ═══════"

lookbackBars = input.int(
     group=generalSettings,
     defval=5000,
     title="Lookback Bars",
     minval=1,
     maxval=50000)

maxBoxes = input.int(
     group=generalSettings,
     defval=500,
     title="Max PD Arrays",
     minval=1,
     maxval=5000)

// ═══════════════════════════════════════════════════════════════
// 🛠 FVG SETTINGS
// ═══════════════════════════════════════════════════════════════
fvgSettings = "═══════ FVG SETTINGS ═══════"
showFvgs        = input.bool  (group=fvgSettings, defval=true,   title="Show FVGs?")
stretchFvgs     = input.bool  (group=fvgSettings, defval=true,   title="📏 Stretch FVGs until filled?")
autoDeleteFvgs  = input.bool  (group=fvgSettings, defval=true,   title="🗑️ Auto-delete when filled?")
fvgTouchMode    = input.string(group=fvgSettings, defval="Mèche",title="FVG fill trigger", options=["Mèche","Corps"])
fvgBullText     = input.string(group=fvgSettings, defval="+FVG", title="BISI ↑",  inline="+FVG")
fvgBullColor    = input.color (group=fvgSettings, defval=color.rgb(119,193,253),  title="", inline="+FVG")
fvgBearText     = input.string(group=fvgSettings, defval="-FVG", title="SIBI ↓",  inline="-FVG")
fvgBearColor    = input.color (group=fvgSettings, defval=color.rgb(252,188,94),   title="", inline="-FVG")
fvgBackgroundOpacity = input.int(group=fvgSettings, defval=90, title="Background Opacity", minval=0, maxval=100)
fvgTextOpacity       = input.int(group=fvgSettings, defval=0,  title="Text Opacity",       minval=0, maxval=100)
showFvgBorders  = input.bool  (group=fvgSettings, defval=true,  title="Show FVG borders?")

