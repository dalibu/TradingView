obBullText     = input.string(group=obSettings, defval="+OB",   title="Order Block ↑", inline="+OB")
obBullColor    = input.color (group=obSettings, defval=color.green,   title="", inline="+OB")
obBearText     = input.string(group=obSettings, defval="-OB",   title="Order Block ↓", inline="-OB")
obBearColor    = input.color (group=obSettings, defval=color.orange,  title="", inline="-OB")
obBackgroundOpacity = input.int(group=obSettings, defval=85, title="Background Opacity", minval=0, maxval=100)
obTextOpacity       = input.int(group=obSettings, defval=0,  title="Text Opacity",       minval=0, maxval=100)
