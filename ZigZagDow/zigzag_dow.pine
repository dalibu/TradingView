
 // This source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// Основа: Dev Lucem ZigZag++
// Модификация: тренд по Доу, последний импульс и последний откат
// Исправлены направление точек и хранение оснований импульсов.

//@version=5
import DevLucem/ZigLib/1 as ZigZag

indicator("ZigZag Доу — последний импульс и откат",
     shorttitle="ZigZag Доу",
     overlay=true,
     format=format.price,
     max_lines_count=300)

//==================================================
// НАСТРОЙКИ ZIGZAG
//==================================================

depth = input.int(12, "Глубина поиска", minval=1, step=1,
     group="Настройки ZigZag")

deviation = input.int(5, "Минимальное отклонение", minval=1, step=1,
     group="Настройки ZigZag")

backstep = input.int(2, "Шаг назад", minval=2, step=1,
     group="Настройки ZigZag")

repaint = input.bool(true, "Перерисовывать последний отрезок",
     group="Настройки ZigZag")

//==================================================
// ОФОРМЛЕНИЕ ZIGZAG
//==================================================

lineWidth = input.int(2, "Толщина линий ZigZag",
     minval=1, maxval=4, group="Оформление ZigZag")

upColor = input.color(color.lime, "Цвет восходящего тренда",
     group="Оформление ZigZag")

downColor = input.color(color.red, "Цвет нисходящего тренда",
     group="Оформление ZigZag")

lineTransparency = input.int(0, "Прозрачность линий",
     minval=0, maxval=100, group="Оформление ZigZag")

extendZigZag = input.bool(false, "Продлевать последний отрезок",
     group="Оформление ZigZag")

//==================================================
// ГОРИЗОНТАЛЬНЫЕ УРОВНИ
//==================================================

showLevelLine = input.bool(true, "Показывать уровень тренда",
     group="Уровни последнего импульса")

extendLevelLine = input.bool(true, "Продлевать уровень вправо",
     group="Уровни последнего импульса")

levelWidth = input.int(2, "Толщина уровня",
     minval=1, maxval=5, group="Уровни последнего импульса")

bullLevelColor = input.color(color.lime, "Цвет уровня восходящего тренда",
     group="Уровни последнего импульса")

bearLevelColor = input.color(color.red, "Цвет уровня нисходящего тренда",
     group="Уровни последнего импульса")

//==================================================
// РАСЧЁТ ZIGZAG
//==================================================

// Библиотека возвращает направление и две точки ZigZag.
// В исходном ZigZag++ direction > 0 соответствует максимуму,
// а direction < 0 — минимуму.

[direction, z1, z2] = ZigZag.zigzag(
     low, high, depth, deviation, backstep)

directionChanged = ta.change(direction) != 0

//==================================================
// ПАМЯТЬ ПОДТВЕРЖДЁННЫХ МАКСИМУМОВ И МИНИМУМОВ
//==================================================

// Два последних максимума.

var float previousHigh = na
var int previousHighTime = na

var float lastHigh = na
var int lastHighTime = na

// Два последних минимума.

var float previousLow = na
var int previousLowTime = na

var float lastLow = na
var int lastLowTime = na

// Основание последнего движения к максимуму — минимум.

var float lastHighBaseLow = na
var int lastHighBaseLowTime = na

// Основание предыдущего движения к максимуму.

var float previousHighBaseLow = na
var int previousHighBaseLowTime = na

// Основание последнего движения к минимуму — максимум.

var float lastLowBaseHigh = na
var int lastLowBaseHighTime = na

// Основание предыдущего движения к минимуму.

var float previousLowBaseHigh = na
var int previousLowBaseHighTime = na

//==================================================
// ОБНОВЛЕНИЕ ТОЧЕК ZIGZAG
//==================================================

// Используется предыдущее значение z2, как в исходном
// примере ZigZag++ при фиксации смены направления.

if directionChanged and not na(z2.price[1]) and not na(z2.time[1])

    if direction > 0
        // Подтверждён максимум.
        previousHigh := lastHigh
        previousHighTime := lastHighTime

        lastHigh := z2.price[1]
        lastHighTime := z2.time[1]

        // Основание этого максимума — предыдущий минимум.
        previousHighBaseLow := lastHighBaseLow
        previousHighBaseLowTime := lastHighBaseLowTime

        lastHighBaseLow := lastLow
        lastHighBaseLowTime := lastLowTime

    else if direction < 0
        // Подтверждён минимум.
        previousLow := lastLow
        previousLowTime := lastLowTime

        lastLow := z2.price[1]
        lastLowTime := z2.time[1]

        // Основание этого минимума — предыдущий максимум.
        previousLowBaseHigh := lastLowBaseHigh
        previousLowBaseHighTime := lastLowBaseHighTime

        lastLowBaseHigh := lastHigh
        lastLowBaseHighTime := lastHighTime

//==================================================
// СОСТОЯНИЕ ТРЕНДА ПО ДОУ
//  1 = восходящий
// -1 = нисходящий
//  0 = ещё не определён
//==================================================

var int trend = 0

// Последний уровень поддержки восходящего тренда.

var float lastPushPrice = na
var int lastPushTime = na

// Последний уровень сопротивления нисходящего тренда.

var float lastReturnPrice = na
var int lastReturnTime = na

//==================================================
// ПЕРВИЧНОЕ ОПРЕДЕЛЕНИЕ ТРЕНДА
//==================================================

if trend == 0
    enoughPivots = not na(previousHigh) and
         not na(lastHigh) and
         not na(previousLow) and
         not na(lastLow)

    if enoughPivots
        highsRising = lastHigh > previousHigh
        lowsRising = lastLow > previousLow

        highsFalling = lastHigh < previousHigh
        lowsFalling = lastLow < previousLow

        if highsRising and lowsRising
            trend := 1

            lastPushPrice := lastHighBaseLow
            lastPushTime := lastHighBaseLowTime

            lastReturnPrice := na
            lastReturnTime := na

        else if highsFalling and lowsFalling
            trend := -1

            lastReturnPrice := lastLowBaseHigh
            lastReturnTime := lastLowBaseHighTime

            lastPushPrice := na
            lastPushTime := na

//==================================================
// ВОСХОДЯЩИЙ ТРЕНД: ОБНОВЛЕНИЕ ПОСЛЕДНЕГО ИМПУЛЬСА
//==================================================

// Если сформирован новый более высокий максимум,
// основание движения становится новым уровнем поддержки.

if trend == 1 and directionChanged and direction > 0
    newHigherHigh = not na(previousHigh) and
         not na(lastHigh) and
         lastHigh > previousHigh

    if newHigherHigh and not na(lastHighBaseLow)
        lastPushPrice := lastHighBaseLow
        lastPushTime := lastHighBaseLowTime

//==================================================
// НИСХОДЯЩИЙ ТРЕНД: ОБНОВЛЕНИЕ ПОСЛЕДНЕГО ОТКАТА
//==================================================

// Если сформирован новый более низкий минимум,
// основание движения становится новым уровнем сопротивления.

if trend == -1 and directionChanged and direction < 0
    newLowerLow = not na(previousLow) and
         not na(lastLow) and
         lastLow < previousLow

    if newLowerLow and not na(lastLowBaseHigh)
        lastReturnPrice := lastLowBaseHigh
        lastReturnTime := lastLowBaseHighTime

//==================================================
// СМЕНА ТРЕНДА ПРИ ПРОБОЕ УРОВНЯ
//==================================================

// Пробой подтверждается закрытием свечи за уровнем.
// Вторая проверка выполняется только если первая не сработала.

if trend == 1 and not na(lastPushPrice) and close < lastPushPrice
    trend := -1

    // Для нового нисходящего тренда используем основание
    // последнего подтверждённого нисходящего импульса.

    lastReturnPrice := lastLowBaseHigh
    lastReturnTime := lastLowBaseHighTime

    lastPushPrice := na
    lastPushTime := na

else if trend == -1 and not na(lastReturnPrice) and close > lastReturnPrice
    trend := 1

    // Для нового восходящего тренда используем основание
    // последнего подтверждённого восходящего импульса.

    lastPushPrice := lastHighBaseLow
    lastPushTime := lastHighBaseLowTime

    lastReturnPrice := na
    lastReturnTime := na

//==================================================
// ЦВЕТ ZIGZAG ПО НАПРАВЛЕНИЮ ТРЕНДА
//==================================================

trendColor = trend == 1 ? upColor :
     trend == -1 ? downColor : color.gray

//==================================================
// ОТРИСОВКА ZIGZAG
//==================================================

line zz = na

if repaint
    zz := line.new(
         z1, z2,
         xloc=xloc.bar_time,
         extend=extendZigZag ? extend.right : extend.none,
         color=color.new(trendColor, lineTransparency),
         width=lineWidth)

    // Пока направление не изменилось, заменяем
    // предыдущий незавершённый отрезок.

    if direction == direction[1]
        if not na(zz[1])
            line.delete(zz[1])
    else
        if not na(zz[1])
            line.set_extend(zz[1], extend.none)

else
    // Без перерисовки рисуем только завершённые отрезки.

    if directionChanged
        zz := line.new(
             z1[1], z2[1],
             xloc=xloc.bar_time,
             extend=extend.none,
             color=color.new(trendColor[1], lineTransparency),
             width=lineWidth)

//==================================================
// ГОРИЗОНТАЛЬНЫЙ УРОВЕНЬ ТРЕНДА
//==================================================

// Линия создаётся один раз, а затем изменяется.
// Это уменьшает число лишних объектов на графике.

var line levelLine = na

float activeLevel = trend == 1 ? lastPushPrice :
     trend == -1 ? lastReturnPrice : na

int activeLevelTime = trend == 1 ? lastPushTime :
     trend == -1 ? lastReturnTime : na

color activeLevelColor = trend == 1 ? bullLevelColor : bearLevelColor

bool validLevel = showLevelLine and
     not na(activeLevel) and
     not na(activeLevelTime)

if validLevel
    if na(levelLine)
        levelLine := line.new(
             x1=activeLevelTime,
             y1=activeLevel,
             x2=time,
             y2=activeLevel,
             xloc=xloc.bar_time,
             extend=extendLevelLine ? extend.right : extend.none,
             color=activeLevelColor,
             width=levelWidth)
    else
        line.set_xy1(levelLine, activeLevelTime, activeLevel)
        line.set_xy2(levelLine, time, activeLevel)
        line.set_extend(levelLine,
             extendLevelLine ? extend.right : extend.none)
        line.set_color(levelLine, activeLevelColor)
        line.set_width(levelLine, levelWidth)

else
    if not na(levelLine)
        line.delete(levelLine)
        levelLine := na
