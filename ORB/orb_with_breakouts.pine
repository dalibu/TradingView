// Modified: multi-session version (each session has its own OR window, time zone and color)

//@version=6
indicator("Multi-Session ORB with Breakouts & Targets [based on LuxAlgo]", shorttitle = "Multi ORB", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
//inputs
//---------------------------------------------------------------------------------------------------------------------{

//Historical Display
showHist = input.bool(true, title = "Show Historical Data", group = "Historical Display", tooltip = "Displays All Data from Previous Sessions")

//Session 1 (default: Tokyo, yellow)
s1_en    = input.bool(true, title = "Enable", group = "Session 1", inline = "s1a")
s1_name  = input.string("Tokyo", title = "", group = "Session 1", inline = "s1a")
s1_color = input.color(#fdd835, title = "", group = "Session 1", inline = "s1a")
s1_sesh  = input.session("0900-0930", title = "OR Window", group = "Session 1", inline = "s1b", tooltip = "Opening Range window in the selected time zone. The window length defines the OR length.")
s1_full  = input.session("0900-1500", title = "Session", group = "Session 1", inline = "s1c", tooltip = "Full trading session in the selected time zone. ORH/ORL, targets and signals stop being extended/generated when it ends.")
s1_tz    = input.string("Asia/Tokyo", title = "", group = "Session 1", inline = "s1c", options = ["Asia/Tokyo", "Asia/Hong_Kong", "Asia/Shanghai", "Asia/Singapore", "Asia/Kolkata", "Asia/Dubai", "Europe/London", "Europe/Berlin", "America/New_York", "America/Chicago", "America/Los_Angeles", "Australia/Sydney", "UTC"])

//Session 2 (default: New York, blue)
s2_en    = input.bool(true, title = "Enable", group = "Session 2", inline = "s2a")
s2_name  = input.string("New York", title = "", group = "Session 2", inline = "s2a")
s2_color = input.color(#2962ff, title = "", group = "Session 2", inline = "s2a")
s2_sesh  = input.session("0930-1000", title = "OR Window", group = "Session 2", inline = "s2b", tooltip = "Opening Range window in the selected time zone. The window length defines the OR length.")
s2_full  = input.session("0930-1600", title = "Session", group = "Session 2", inline = "s2c", tooltip = "Full trading session in the selected time zone. ORH/ORL, targets and signals stop being extended/generated when it ends.")
s2_tz    = input.string("America/New_York", title = "", group = "Session 2", inline = "s2c", options = ["Asia/Tokyo", "Asia/Hong_Kong", "Asia/Shanghai", "Asia/Singapore", "Asia/Kolkata", "Asia/Dubai", "Europe/London", "Europe/Berlin", "America/New_York", "America/Chicago", "America/Los_Angeles", "Australia/Sydney", "UTC"])

//Breakout Signals
sigTog = input.bool(true, title = "Show Breakout Signals", group = "Breakout Signals")
useBias = input.string("No Bias", title = "Signal Bias", options = ["No Bias","Daily Bias"], group = "Breakout Signals", tooltip = "OR Fill Color is directional based on if the current Day/Session ORM is Above or Below the Previous ORM.\nExamples\nNo Bias: Signals Occur Regardless of OR Color\nDaily Bias: Signals do not fire until Target 1 when Breakout is in opposite direction of OR Color.") == "No Bias" ? false : true
sigSize = str.lower(input.string("Small", title = "Signal Size", options = ["Tiny","Small","Normal","Large","Huge"], group = "Breakout Signals"))
upSigColor = input.color(#089981, title = "Up Color", group = "Breakout Signals", inline = "Colors")
downSigColor = input.color(#f23645, title = "Down Color", group = "Breakout Signals", inline = "Colors")

//Targets
tTog = input.bool(true, title = "Show Targets", group = "Targets")
tPer = input.float(50, minval = 1, title = "Target % of Range", group = "Targets", tooltip = "Uses this % of OR Width to use as the distance for targets.")*0.01
tSrc = input.string("Close", title = "Target Cross Source", options = ["Close","Highs/Lows"], group = "Targets", tooltip = "Uses this Source to tell the script when a target is hit in order to draw the next target.")
tDispType = input.string("Adaptive", title = "Target Display", options = ["Adaptive","Extended"], group = "Targets", tooltip = "Adaptive: Displays and hides targets Adaptivly based on the current price.\nExtended: Extends all targets to the current bar and does not hide any targets after generation.")
tSessCol = input.bool(false, title = "Targets Use Session Color", group = "Targets", tooltip = "Off: targets are green/red (as in the original). On: targets are drawn in the color of their session.")

//Session Moving Average (shared settings, drawn in each session's color)
maTog = input.bool(false, title = "", inline = "MA", group = "Session Moving Average")
maLen = input.int(20, title = "", inline = "MA", group = "Session Moving Average")
maType = input.string("EMA", title = "", options=["SMA", "EMA", "RMA", "WMA", "VWMA"], inline = "MA", group = "Session Moving Average", tooltip  = "Moving average resets on the start of each session (at Opening Range Start). Each session's MA uses that session's color.")

//Style
green = input.color(color.new(#089981,60), title = " Bull Target Color", group = "Style", inline = "Bull")
red = input.color(color.new(#f23645,60), title = "Bear Target Color", group = "Style", inline = "Bear")
greenFill = input.color(color.new(#089981,80), title = " Bull Fill Color", group = "Style", inline = "Bull")
redFill = input.color(color.new(#f23645,80), title = "Bear Fill Color", group = "Style", inline = "Bear")
orFillTransp = input.int(60, title = "OR Box Transparency", minval = 0, maxval = 100, group = "Style")
tStyle = input.string("___", title = "Target Style", options = ["___","- - -",". . ."], group = "Style")
txtSize = str.lower(input.string("Small", title = "Text Size", options = ["Tiny","Small","Normal","Large","Huge"], group = "Style"))

invis = color.rgb(0,0,0,100)

//---------------------------------------------------------------------------------------------------------------------}
//Error
//---------------------------------------------------------------------------------------------------------------------{
if timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds("D")
    runtime.error("Timeframe is too High! Please Reduce Timeframe to be Less-Than 1 Day.")

//---------------------------------------------------------------------------------------------------------------------}
//Functions
//---------------------------------------------------------------------------------------------------------------------{
fz(_val) => _val == 0 ? 1 : _val

day_ma(_start,_type,s,l) =>
    bs_nd = fz(ta.barssince(_start))
    v_len = bs_nd < l?bs_nd:l
    var float ma = na
    if _type == "EMA"
        k = 2/(v_len + 1)
        ma := (s*k) + (nz(ma[1])*(1-k))
    if _type == "RMA"
        a = (1/v_len)
        ma := a * s + (1 - a) * nz(ma[1])
    if _type == "SMA"
        ma := ta.sma(s,v_len)
    if _type == "WMA"
        ma := ta.wma(s,v_len)
    if _type == "VWMA"
        ma := ta.vwma(s,v_len)
    ma

linestyle(_input) =>
    _input == "___"?line.style_solid:
     _input == "- - -"?line.style_dashed:
     _input == ". . ."?line.style_dotted:
     na

get_1up(_val) => (_val - math.floor(_val)) > 0 ? int(math.floor(_val) + 1) : int(_val)

//---------------------------------------------------------------------------------------------------------------------}
//UDTs
//---------------------------------------------------------------------------------------------------------------------{

type target
    line ln
    label lab

//---------------------------------------------------------------------------------------------------------------------}
//ORB engine (one independent instance per call, each keeps its own state)
//---------------------------------------------------------------------------------------------------------------------{

orb(bool en, string name, string sesh, string full, string tz, color sc) =>

    //State (persistent per call)
    var up_targs = array.new<target>()
    var down_targs = array.new<target>()
    var signals = array.new_label()

    var bool or_sesh = false
    var bool or_token = false

    var float orh = na
    var float orl = na
    var float hst = na
    var float lst = na
    var float prev_orm = na

    var int up_count = na
    var int down_count = na

    var box or_bx = na

    var int day_dir = 0
    var bool down_check = false
    var bool up_check = false
    bool down_signal = false
    bool up_signal = false

    var target h_ln = target.new(na,na)
    var target l_ln = target.new(na,na)
    var line m_ln = na

    //Session colors
    orColor = sc
    orFillColor = color.new(sc, orFillTransp)
    bullT = tSessCol ? color.new(sc, 60) : green
    bearT = tSessCol ? color.new(sc, 60) : red

    //Calculations
    orm = math.avg(orh,orl)
    orw = math.abs(orh-orl)

    h_src = tSrc == "Close" ? close : high
    l_src = tSrc == "Close" ? close : low

    //Establishing when the OR session is
    or_sesh := en and not na(time(timeframe.period, sesh, tz))
    in_full = en and not na(time(timeframe.period, full, tz))

    or_start = or_sesh and not or_sesh[1]
    or_end = or_sesh[1] and not or_sesh

    //On start of OR session
    if or_start
        for targ in up_targs
            if showHist == false
                targ.ln.delete()
            targ.lab.delete()

        for targ in down_targs
            if showHist == false
                targ.ln.delete()
            targ.lab.delete()

        for lab in signals
            if showHist == false
                lab.delete()

        if showHist == false
            or_bx.delete()
            h_ln.ln.delete()
            l_ln.ln.delete()
            m_ln.delete()

        h_ln.lab.delete()
        l_ln.lab.delete()
        up_targs.clear()
        down_targs.clear()

        orh := high
        orl := low
        prev_orm := orm[1]
        up_count := 0
        down_count := 0
        up_check := true
        down_check := true

        or_bx := box.new(bar_index,high,bar_index,low, bgcolor = orFillColor, border_width = 0)

        or_token := false

    //Running while OR session is live
    if or_sesh
        if high > orh
            orh := high
        if low < orl
            orl := low
        or_bx.set_top(orh)
        or_bx.set_bottom(orl)
        or_bx.set_right(bar_index)
        if orh != orl
            or_token := true

    //On end of OR session
    if or_end and or_token
        h_ln := target.new(line.new(bar_index,orh,bar_index,orh, color = orColor),label.new(bar_index,orh,text = name + " ORH",tooltip = str.tostring(orh,format.mintick), style = label.style_label_left, color = invis, textcolor = color.new(orColor,0), size = txtSize))
        l_ln := target.new(line.new(bar_index,orl,bar_index,orl, color = orColor),label.new(bar_index,orl,text = name + " ORL",tooltip = str.tostring(orl,format.mintick), style = label.style_label_left, color = invis, textcolor = color.new(orColor,0), size = txtSize))
        m_ln := line.new(bar_index,orm,bar_index,orm, style = line.style_dashed, color = orColor)
        hst := orh + (orw*tPer)
        lst := orl - (orw*tPer)

        day_dir := orm > prev_orm ? 1 : orm < prev_orm ? -1 : 0
        linefill.new(h_ln.ln,l_ln.ln, day_dir == 1 ? greenFill : day_dir == -1 ? redFill : invis)

    //Running outside of OR session (only until the end of the trading session)
    if not or_sesh and or_token and in_full
        h_ln.ln.set_x2(bar_index)
        l_ln.ln.set_x2(bar_index)
        h_ln.lab.set_x(bar_index)
        l_ln.lab.set_x(bar_index)
        m_ln.set_x2(bar_index)

    //Target calculations
    if h_src > hst
        hst := h_src
    if l_src < lst
        lst := l_src

    up_max = get_1up((hst - orh)/(orw*tPer))
    down_max = get_1up((orl - lst)/(orw*tPer))

    up_cur = math.max(0,get_1up((h_src - orh)/(orw*tPer)))
    down_cur = math.max(0,get_1up((orl - l_src)/(orw*tPer)))

    //Signal calcs
    if (close > orm and down_check == false)
        down_check := true

    xdown = ta.crossunder(close,orl)
    xdown2 = ta.crossunder(close,orl-orw*tPer)
    if (useBias ? ((day_dir != 1 and xdown) or (day_dir == 1 and xdown2)) : xdown) and down_check and in_full
        down_signal := true
        down_check := false

    if (close < orm and up_check == false)
        up_check := true

    xup = ta.crossover(close,orh)
    xup2 = ta.crossover(close,orh+orw*tPer)
    if (useBias ? ((day_dir != -1 and xup) or (day_dir == -1 and xup2)) : xup) and up_check and in_full
        up_signal := true
        up_check := false

    //Targets
    if not or_sesh and or_token and in_full
        if up_count < up_max and tTog
            for i = (up_count+1) to up_max
                up_targs.push(target.new(
                  line.new(bar_index-1,(orh+orw*tPer*i),bar_index,(orh+(orw*tPer*i)), color = bullT, style = linestyle(tStyle)),
                  label.new(bar_index,(orh+orw*tPer*i),text = str.tostring(i),tooltip = name + " " + str.tostring(orh+orw*tPer*i,format.mintick), style = label.style_label_left, color = invis, textcolor = color.new(bullT,0), size = txtSize)
                  ))
                if i == up_max
                    up_count := up_max
        if down_count < down_max and tTog
            for i = (down_count+1) to down_max
                down_targs.push(target.new(
                  line.new(bar_index-1,(orl-orw*tPer*i),bar_index,(orl-(orw*tPer*i)), color = bearT, style = linestyle(tStyle)),
                  label.new(bar_index,(orl-orw*tPer*i),text = str.tostring(i),tooltip = name + " " + str.tostring(orl-orw*tPer*i,format.mintick), style = label.style_label_left, color = invis, textcolor = color.new(bearT,0), size = txtSize)
                  ))
                if i == down_max
                    down_count := down_max

    //Extending to current bar
    if tDispType == "Extended" and tTog and in_full
        for targ in up_targs
            targ.ln.set_x2(bar_index)
            targ.lab.set_x(bar_index)
        for targ in down_targs
            targ.ln.set_x2(bar_index)
            targ.lab.set_x(bar_index)

    if tDispType == "Adaptive" and tTog and in_full
        for targ in up_targs
            if targ.ln.get_y1() <= (orh+(orw*tPer*(up_cur))) and targ.ln.get_y1() >= (orh+(orw*tPer*(up_cur-2)))
                targ.ln.set_x2(bar_index+1)
                targ.lab.set_x(bar_index+1)
        for targ in down_targs
            if targ.ln.get_y1() <= (orl-(orw*tPer*(down_cur-2))) and targ.ln.get_y1() >= (orl-(orw*tPer*(down_cur)))
                targ.ln.set_x2(bar_index+1)
                targ.lab.set_x(bar_index+1)

    //Signals
    if up_signal and sigTog
        signals.push(label.new(bar_index, orl,
          style = label.style_label_center,
          text = "\n▲",
          color = invis,
          textcolor = upSigColor,
          size = sigSize))

    if down_signal and sigTog
        signals.push(label.new(bar_index, orh,
          style = label.style_label_center,
          text = "▼\n",
          color = invis,
          textcolor = downSigColor,
          size = sigSize))

    //Session moving average (returned, plotted outside)
    ma = day_ma(or_start,maType,close,maLen)
    or_start ? na : ma

//---------------------------------------------------------------------------------------------------------------------}
//Run sessions
//---------------------------------------------------------------------------------------------------------------------{

ma1 = orb(s1_en, s1_name, s1_sesh, s1_full, s1_tz, s1_color)
ma2 = orb(s2_en, s2_name, s2_sesh, s2_full, s2_tz, s2_color)

plot(ma1, style = plot.style_linebr, color = s1_color, display = (maTog and s1_en) ? display.all : display.none, title = "Session 1 MA", editable = false)
plot(ma2, style = plot.style_linebr, color = s2_color, display = (maTog and s2_en) ? display.all : display.none, title = "Session 2 MA", editable = false)

//---------------------------------------------------------------------------------------------------------------------}
