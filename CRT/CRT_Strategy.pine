//@version=6
strategy(
     "CRT Wick Strategy — RR 1.5",
     overlay = true,
     pyramiding = 0,
     process_orders_on_close = true,
     initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100)

// Inputs
rr = input.float(1.5, "Risk / Reward", minval=0.1, step=0.1)
showSignals = input.bool(true, "Show signals")

// C1 / C2 / C3
if bar_index >= 2 and strategy.position_size == 0
    float c1High = high[2]
    float c1Low  = low[2]
    float c2High = high[1]
    float c2Low = low[1]
    float c3High = high
    float c3Low = low
    float c3Close = close

    bool sweepLow = c2Low < c1Low
    bool sweepHigh = c2High > c1High
    bool singleSweepLow = sweepLow and not sweepHigh
    bool singleSweepHigh = sweepHigh and not sweepLow

    bool bullCRT = singleSweepLow and c3High <= c1High
    bool bearCRT = singleSweepHigh and c3Low >= c1Low
    bool bullCONT = singleSweepHigh and c3Low < c1Low
    bool bearCONT = singleSweepLow and c3High > c1High

    int setupType = 0
    int direction = 0
    float sl = na

    if bullCRT
        setupType := 1
        direction := 1
        sl := c1Low
    else if bearCRT
        setupType := 2
        direction := -1
        sl := c1High
    else if bullCONT
        setupType := 3
        direction := 1
        sl := c1Low
    else if bearCONT
        setupType := 4
        direction := -1
        sl := c1High

    if setupType > 0
        float entry = c3Close
        float risk = math.abs(entry - sl)
        bool validGeometry =
             risk > 0 and
             (
                 (direction == 1 and entry > sl) or
                 (direction == -1 and entry < sl)
             )

        if validGeometry
            float tp =
                 direction == 1 ?
                 entry + risk * rr :
                 entry - risk * rr

            if direction == 1
                strategy.entry("LONG", strategy.long)
                strategy.exit("LONG EXIT", from_entry = "LONG", stop = sl, limit = tp)
            else
                strategy.entry("SHORT", strategy.short)
                strategy.exit("SHORT EXIT", from_entry = "SHORT", stop = sl, limit = tp)

            if showSignals
                string txt =
                     setupType == 1 ? "Bull CRT" :
                     setupType == 2 ? "Bear CRT" :
                     setupType == 3 ? "Bull CONT" :
                     "Bear CONT"

                label.new(
                     bar_index,
                     direction == 1 ? low : high,
                     txt,
                     style =
                         direction == 1 ?
                         label.style_label_up :
                         label.style_label_down,
                     textcolor = color.white)
