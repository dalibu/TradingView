//@version=6
indicator("[ArtiShock] Universal Warrant Position Sizer (v1)", overlay=true)

// --- INPUTS ---
grp_trade = "Trade Direction"
tradeDir = input.string("Long", "Direction", options=["Long", "Short"], group=grp_trade, tooltip="Select 'Long' for Call warrants or 'Short' for Put warrants.")

grp_risk = "Risk & Fees"
maxRisk  = input.float(100.0, "Max. Risk Budget", group=grp_risk, tooltip="Total amount to risk in account currency.")
fees     = input.float(1.0, "Fee per Order", group=grp_risk, tooltip="Broker fee per transaction.")

grp_os = "Warrant / Derivative Data"
osPrice  = input.float(1.42, "Warrant Price (Ask)", group=grp_os, tooltip="Current purchase price.")
osHebel  = input.float(15.0, "Leverage", group=grp_os, tooltip="Current warrant leverage.")
osSpread = input.float(0.01, "Spread", group=grp_os, tooltip="Difference between Ask and Bid.")

grp_sl = "Stop-Loss Settings"
slMode   = input.string("Manual", "SL Mode", options=["Manual", "ATR-Based"], group=grp_sl, tooltip="Choose between a fixed price or a volatility-based (ATR) Stop-Loss.")
slManual = input.float(4526.0, "Manual SL Price", group=grp_sl, tooltip="Enter your technical chart SL here.")
atrLen   = input.int(14, "ATR Length", minval=1, group=grp_sl)
atrMult  = input.float(1.5, "ATR Multiplier", step=0.1, group=grp_sl, tooltip="Default is 1.5 or 1.7. Higher means more 'breathing room'.")

grp_ui = "User Interface"
tablePos = input.string("Top Right", "Dashboard Placement", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group=grp_ui)

// --- CALCULATIONS ---
currentAssetPrice = close
atrValue = ta.atr(atrLen)

// Determine Asset SL based on Mode
float slAsset = na
if slMode == "Manual"
    slAsset := slManual
else
    slAsset := tradeDir == "Long" ? currentAssetPrice - (atrValue * atrMult) : currentAssetPrice + (atrValue * atrMult)

// 1. Asset price movement in %
assetMovePct = tradeDir == "Long" ? (currentAssetPrice - slAsset) / currentAssetPrice : (slAsset - currentAssetPrice) / currentAssetPrice

// 2. Warrant price drop in % (Leverage effect)
osDropPct = assetMovePct * osHebel

// 3. Stop-Loss Price for the Warrant (Real Bid Price)
osSLPrice = osPrice * (1 - osDropPct) - osSpread
osLossPerUnit = osPrice - osSLPrice

// 4. Available budget for price loss (minus 2x fees) ---
netRiskBudget = maxRisk - (2 * fees)

// 5. Position Sizing (Fixed syntax) ---
quantity = math.max(0, math.floor(netRiskBudget / osLossPerUnit))

// 6. Target calculations (RRR)
tp1  = osPrice + (osLossPerUnit * 1.0)
tp15 = osPrice + (osLossPerUnit * 1.5)
tp2  = osPrice + (osLossPerUnit * 2.0)
tp3  = osPrice + (osLossPerUnit * 3.0)

calcAssetTP(targetOS) =>
    osGainPct = (targetOS - osPrice) / osPrice
    move = (osGainPct / osHebel)
    tradeDir == "Long" ? currentAssetPrice * (1 + move) : currentAssetPrice * (1 - move)

// --- DYNAMIC DASHBOARD ---
var string actualPos = switch tablePos
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    "Middle Right" => position.middle_right
    => position.top_right

var table mainTable = table.new(actualPos, 2, 10, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

if barstate.islast
    mainTable := table.new(actualPos, 2, 10, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)
    c_white = color.white
    
    table.cell(mainTable, 0, 0, "Dir: " + tradeDir + " | Mode: " + slMode, text_color=tradeDir == "Long" ? color.lime : color.red, text_halign=text.align_left)
    table.cell(mainTable, 1, 0, "Qty: " + str.tostring(quantity, "#"), text_color=color.yellow)
    
    table.cell(mainTable, 0, 1, "Asset SL Level:", text_color=c_white, text_halign=text.align_left)
    table.cell(mainTable, 1, 1, str.tostring(slAsset, "#.##"), text_color=color.orange)

    table.cell(mainTable, 0, 2, "Warrant SL Order:", text_color=c_white, text_halign=text.align_left)
    table.cell(mainTable, 1, 2, str.tostring(osSLPrice, "#.###"), text_color=color.orange)
    
    table.cell(mainTable, 0, 3, "--- Targets (OS) ---", text_color=color.gray)
    table.cell(mainTable, 1, 3, "--- Asset Goal ---", text_color=color.gray)
    
    table.cell(mainTable, 0, 4, "TP 1.0 (1:1): " + str.tostring(tp1, "#.###"), text_color=c_white, text_halign=text.align_left)
    table.cell(mainTable, 1, 4, str.tostring(calcAssetTP(tp1), "#.##"), text_color=color.lime)

    table.cell(mainTable, 0, 5, "TP 1.5 (1.5:1): " + str.tostring(tp15, "#.###"), text_color=c_white, text_halign=text.align_left)
    table.cell(mainTable, 1, 5, str.tostring(calcAssetTP(tp15), "#.##"), text_color=color.lime)
    
    table.cell(mainTable, 0, 6, "TP 2.0 (2:1): " + str.tostring(tp2, "#.###"), text_color=c_white, text_halign=text.align_left)
    table.cell(mainTable, 1, 6, str.tostring(calcAssetTP(tp2), "#.##"), text_color=color.lime)

plot(slAsset, "Stop-Loss Line", color=color.red, style=plot.style_linebr, linewidth=2)
