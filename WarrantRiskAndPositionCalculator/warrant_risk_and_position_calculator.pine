//@version=6
indicator("[ArtiShock] Universal Warrant Position Calculator (v1)", overlay=true)

// --- INPUTS ---
grp_trade = "Trade Direction"
tradeDir = input.string("Long", "Direction", options=["Long", "Short"], group=grp_trade, tooltip="Select 'Long' for Call warrants (bullish) or 'Short' for Put warrants (bearish).")

grp_risk = "Risk & Fees"
maxRisk  = input.float(100.0, "Max. Risk Budget", group=grp_risk, tooltip="The maximum amount you are willing to lose in your account currency.")
fees     = input.float(1.0, "Fee per Order", group=grp_risk, tooltip="Broker fee per transaction (buy/sell).")

grp_os = "Warrant / Derivative Data"
osPrice  = input.float(1.0, "Warrant Price (Ask)", step=0.01, group=grp_os, tooltip="Current purchase price in your broker terminal.")
osHebel  = input.int(15, "Leverage", step=1, group=grp_os, tooltip="Current warrant leverage.")
osSpread = input.float(0.01, "Spread", step=0.01, group=grp_os, tooltip="Difference between Ask (buy) and Bid (sell) price.")

grp_sl = "Stop-Loss Settings"
slMode   = input.string("Manual", "SL Mode", options=["Manual", "ATR-Based"], group=grp_sl, tooltip="Choose between a fixed price or a volatility-based (ATR) Stop-Loss.")
entryManual = input.float(4575.0, "Manual Entry Price (Asset)", step=1, group=grp_sl, tooltip="Your entry price. Only used in Manual mode to keep lines static.")
slManual = input.float(4526.0, "Manual SL Price", group=grp_sl)
atrLen   = input.int(14, "ATR Length", step=1, minval=1, group=grp_sl)
atrMult  = input.float(1.5, "ATR Multiplier", step=0.1, group=grp_sl)

grp_ui = "User Interface"
tablePos = input.string("Top Right", "Dashboard Placement", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group=grp_ui)
textSize = input.string("Small", "Table Text Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=grp_ui, tooltip="Adjust the font size of the dashboard table.")

// --- CALCULATIONS ---
currentAssetPrice = close
atrValue = ta.atr(atrLen)
timeDelta = ta.change(time)
lineTimeEnd = time + math.round(nz(timeDelta, 3600000) * 30) 

// 1. Calculate ATR History Path
atrHistoryValue = tradeDir == "Long" ? currentAssetPrice - (atrValue * atrMult) : currentAssetPrice + (atrValue * atrMult)
plot(slMode == "ATR-Based" ? atrHistoryValue : na, "ATR Path", color=color.red, linewidth=1, style=plot.style_linebr)

// 2. Determine Entry and SL strictly by Mode
float entryPrice = slMode == "Manual" ? entryManual : currentAssetPrice
float slAsset = slMode == "Manual" ? slManual : atrHistoryValue

// 3. Asset price movement in %
assetMovePct = math.abs(entryPrice - slAsset) / entryPrice

// 4. Warrant price calculations
osDropPct = assetMovePct * osHebel
osSLPriceAsk = osPrice * (1 - osDropPct)
osSLPrice = osSLPriceAsk - osSpread  // bid price at SL
osLossPerUnit = osPrice - osSLPrice

// 5. Optimal Position Size
netRiskBudget = maxRisk - (2 * fees)
quantity = osLossPerUnit > 0 ? math.floor(netRiskBudget / osLossPerUnit) : 0
quantity := math.max(0, int(quantity))

// 6. Target calculations - Warrant TP based on osLossPerUnit (1R = max risk)
tp1  = osPrice + (osLossPerUnit * 1.0)
tp15 = osPrice + (osLossPerUnit * 1.5)
tp2  = osPrice + (osLossPerUnit * 2.0)
tp3  = osPrice + (osLossPerUnit * 3.0)

calcAssetTP(ratio) =>
    slDistance = math.abs(entryPrice - slAsset)
    tradeDir == "Long" ? entryPrice + (slDistance * ratio) : entryPrice - (slDistance * ratio)

assetTP1  = calcAssetTP(1.0)
assetTP15 = calcAssetTP(1.5)
assetTP2  = calcAssetTP(2.0)
assetTP3  = calcAssetTP(3.0)

// Helper function for Net Profit
calcNetProfit(targetPrice) => (targetPrice - osPrice) * quantity - (2 * fees)

// Helper function for R/P (target price should be ask; convert to bid inside)
calcRP(targetPriceAsk) =>
    targetBid = targetPriceAsk - osSpread
    depositVal = quantity * osPrice
    depositVal + (targetBid - osPrice) * quantity - (2 * fees)

// --- MAPPING & UI ---
var string actualPos = switch tablePos
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    "Middle Right" => position.middle_right
    => position.top_right

var string actualSize = switch textSize
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large
    "Huge"   => size.huge
    => size.small

// --- DYNAMIC DASHBOARD ---
var table mainTable = table.new(actualPos, 5, 8, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

if barstate.islast
    mainTable := table.new(actualPos, 5, 8, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)
    c_white = color.white
    c_gray  = color.gray
    c_orange = color.orange
    
    // ===== HEADER ROW =====
    table.cell(mainTable, 0, 0, "Direction", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 60))
    table.cell(mainTable, 1, 0, "Leverage", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 60))
    table.cell(mainTable, 2, 0, "Ask", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 60))
    table.cell(mainTable, 3, 0, "Deposit", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 60))
    table.cell(mainTable, 4, 0, "Quantity", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 60))
    
    // ===== ENTRY ROW =====
    entry_color = tradeDir == "Long" ? color.lime : color.red
    deposit = quantity * osPrice
    direction_icon = tradeDir == "Long" ? "↑" : "↓"
    table.cell(mainTable, 0, 1, tradeDir + " " + direction_icon, text_color=entry_color, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 1, 1, str.tostring(osHebel, "#") + "x", text_color=color.silver, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 2, 1, str.tostring(osPrice, "#.###"), text_color=color.silver, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 3, 1, str.tostring(deposit, "#.##"), text_color=color.silver, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 4, 1, str.tostring(quantity, "#"), text_color=color.yellow, text_halign=text.align_center, text_size=actualSize)
    
    // ===== LABELS ROW (RRR) =====
    table.cell(mainTable, 0, 2, "RRR", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 80))
    table.cell(mainTable, 1, 2, "Asset", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 80))
    table.cell(mainTable, 2, 2, "Bid", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 80))
    table.cell(mainTable, 3, 2, "Value", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 80))
    table.cell(mainTable, 4, 2, "Profit", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 80))

    // Determine row positions based on direction
    int rowSL = na
    int rowCurrent = na
    int rowTP1 = na
    int rowTP2 = na
    int rowTP3 = na
    
    if tradeDir == "Long"
        rowTP3 := 3
        rowTP2 := 4
        rowTP1 := 5
        rowCurrent := 6
        rowSL := 7
    else  // Short
        rowSL := 3
        rowCurrent := 4
        rowTP1 := 5
        rowTP2 := 6
        rowTP3 := 7

    // ===== CURRENT - arrow row =====
    currentBid = osPrice
    currentValue = currentBid * quantity
    currentProfit = currentValue - deposit - (2 * fees)
    currentPct = quantity > 0 ? (currentProfit / deposit) * 100 : 0
    value_color = currentValue >= deposit ? color.silver : color.red
    profit_color = currentProfit >= 0 ? color.silver : color.red
    table.cell(mainTable, 0, rowCurrent, "→", text_color=color.silver, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 1, rowCurrent, str.tostring(entryPrice, "#.##"), text_color=color.silver, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 2, rowCurrent, str.tostring(currentBid, "#.###"), text_color=color.silver, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 3, rowCurrent, str.tostring(currentValue, "#.##"), text_color=value_color, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 4, rowCurrent, str.tostring(currentProfit, "#.##"), text_color=profit_color, text_halign=text.align_center, text_size=actualSize)

    // ===== STOP LOSS ROW =====
    slBid = osSLPriceAsk - osSpread
    slValue = slBid * quantity
    slProfit = slValue - deposit - (2 * fees)
    slPct = quantity > 0 ? (slProfit / deposit) * 100 : 0
    slLabel = slMode == "Manual" ? "SL (Manual)" : "SL (ATR x" + str.tostring(atrMult, "#.#") + ")"
    table.cell(mainTable, 0, rowSL, slLabel, text_color=color.red, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 1, rowSL, str.tostring(slAsset, "#.##"), text_color=color.red, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 2, rowSL, str.tostring(slBid, "#.###"), text_color=color.red, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 3, rowSL, str.tostring(slValue, "#.##"), text_color=color.red, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 4, rowSL, str.tostring(slProfit, "#.##"), text_color=color.red, text_halign=text.align_center, text_size=actualSize)
    
    // ===== TP 1:1 ROW =====
    tp1Bid = tp1 - osSpread
    tp1Value = tp1Bid * quantity
    tp1Profit = tp1Value - deposit - (2 * fees)
    table.cell(mainTable, 0, rowTP1, "TP 1:1", text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 1, rowTP1, str.tostring(assetTP1, "#.##"), text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 2, rowTP1, str.tostring(tp1Bid, "#.###"), text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 3, rowTP1, str.tostring(tp1Value, "#.##"), text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 4, rowTP1, str.tostring(tp1Profit, "#.##"), text_color=color.lime, text_halign=text.align_center, text_size=actualSize)

    // ===== TP 1:2 ROW =====
    tp2Bid = tp2 - osSpread
    tp2Value = tp2Bid * quantity
    tp2Profit = tp2Value - deposit - (2 * fees)
    table.cell(mainTable, 0, rowTP2, "TP 1:2", text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 1, rowTP2, str.tostring(assetTP2, "#.##"), text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 2, rowTP2, str.tostring(tp2Bid, "#.###"), text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 3, rowTP2, str.tostring(tp2Value, "#.##"), text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 4, rowTP2, str.tostring(tp2Profit, "#.##"), text_color=color.lime, text_halign=text.align_center, text_size=actualSize)

    // ===== TP 1:3 ROW =====
    tp3Bid = tp3 - osSpread
    tp3Value = tp3Bid * quantity
    tp3Profit = tp3Value - deposit - (2 * fees)
    table.cell(mainTable, 0, rowTP3, "TP 1:3", text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 1, rowTP3, str.tostring(assetTP3, "#.##"), text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 2, rowTP3, str.tostring(tp3Bid, "#.###"), text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 3, rowTP3, str.tostring(tp3Value, "#.##"), text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 4, rowTP3, str.tostring(tp3Profit, "#.##"), text_color=color.lime, text_halign=text.align_center, text_size=actualSize)

// --- VISUAL LINES ---

plot(slAsset, "Scale Label", color=color.red, style=plot.style_linebr, trackprice=true, show_last=1)

updateVisuals(lineObj, labelObj, price, txt, lColor, endTime) =>
    line.set_xy1(lineObj, time, price)
    line.set_xy2(lineObj, endTime, price)
    label.set_xy(labelObj, endTime, price)
    label.set_text(labelObj, txt)
    label.set_textcolor(labelObj, lColor)

var slLine = line.new(na, na, na, na, xloc=xloc.bar_time, color=color.red, style=line.style_dashed, width=1)
var slLabel = label.new(na, na, "SL", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=color.red, style=label.style_label_left, size=size.small)

var tp1Line = line.new(na, na, na, na, xloc=xloc.bar_time, color=color.lime, style=line.style_dashed, width=1)
var tp1Label = label.new(na, na, "TP 1.0", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=color.lime, style=label.style_label_left, size=size.small)

//var tp15Line = line.new(na, na, na, na, xloc=xloc.bar_time, color=color.lime, style=line.style_dashed, width=1)
//var tp15Label = label.new(na, na, "TP 1.5", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=color.lime, style=label.style_label_left, size=size.small)

var tp2Line = line.new(na, na, na, na, xloc=xloc.bar_time, color=color.lime, style=line.style_dashed, width=1)
var tp2Label = label.new(na, na, "TP 2.0", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=color.lime, style=label.style_label_left, size=size.small)

var tp3Line = line.new(na, na, na, na, xloc=xloc.bar_time, color=color.lime, style=line.style_dashed, width=1)
var tp3Label = label.new(na, na, "TP 3.0", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=color.lime, style=label.style_label_left, size=size.small)

if barstate.islast
    updateVisuals(slLine, slLabel, slAsset, "SL", color.red, lineTimeEnd)
    updateVisuals(tp1Line, tp1Label, assetTP1, "TP 1.0", color.lime, lineTimeEnd)
//    updateVisuals(tp15Line, tp15Label, assetTP15, "TP 1.5", color.lime, lineTimeEnd)
    updateVisuals(tp2Line, tp2Label, assetTP2, "TP 2.0", color.lime, lineTimeEnd)
    updateVisuals(tp3Line, tp3Label, assetTP3, "TP 3.0", color.lime, lineTimeEnd)
