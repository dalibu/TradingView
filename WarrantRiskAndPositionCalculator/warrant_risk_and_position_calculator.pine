//@version=6
indicator("[ArtiShock] Universal Warrant Position Sizer (v1)", overlay=true)

// --- INPUTS ---
grp_trade = "Trade Direction"
tradeDir = input.string("Long", "Direction", options=["Long", "Short"], group=grp_trade, tooltip="Select 'Long' for Call warrants (bullish) or 'Short' for Put warrants (bearish).")

grp_risk = "Risk & Fees"
maxRisk  = input.float(100.0, "Max. Risk Budget", group=grp_risk, tooltip="The maximum amount you are willing to lose.")
fees     = input.float(1.0, "Fee per Order", group=grp_risk, tooltip="Broker fee per transaction.")

grp_os = "Warrant / Derivative Data"
osPrice  = input.float(1.42, "Warrant Price (Ask)", group=grp_os, tooltip="Current purchase price.")
osHebel  = input.float(15.0, "Leverage", group=grp_os, tooltip="Current warrant leverage.")
osSpread = input.float(0.01, "Spread", group=grp_os, tooltip="Difference between Ask and Bid.")

grp_sl = "Stop-Loss Settings"
slMode   = input.string("Manual", "SL Mode", options=["Manual", "ATR-Based"], group=grp_sl, tooltip="Choose between a fixed price or a volatility-based (ATR) Stop-Loss.")
slManual = input.float(4526.0, "Manual SL Price", group=grp_sl)
atrLen   = input.int(14, "ATR Length", minval=1, group=grp_sl)
atrMult  = input.float(1.5, "ATR Multiplier", step=0.1, group=grp_sl)

grp_ui = "User Interface"
tablePos = input.string("Top Right", "Dashboard Placement", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group=grp_ui)

// --- CALCULATIONS ---
currentAssetPrice = close
atrValue = ta.atr(atrLen)

// Determine Asset SL based on Mode
float slAsset = na
if slMode == "Manual"
    slAsset := slManual
else
    slAsset := tradeDir == "Long" ? currentAssetPrice - (atrValue * atrMult) : currentAssetPrice + (atrValue * atrMult)

// 1. Asset price movement in %
assetMovePct = tradeDir == "Long" ? (currentAssetPrice - slAsset) / currentAssetPrice : (slAsset - currentAssetPrice) / currentAssetPrice

// 2. Warrant price drop in % (Leverage effect)
osDropPct = assetMovePct * osHebel

// 3. Stop-Loss Price for the Warrant (Real Bid Price)
osSLPrice = osPrice * (1 - osDropPct) - osSpread
osLossPerUnit = osPrice - osSLPrice

// 4. Available budget for price loss (minus 2x fees)
netRiskBudget = maxRisk - (2 * fees)

// 5. Optimal Position Size
quantity = osLossPerUnit > 0 ? math.floor(netRiskBudget / osLossPerUnit) : 0
quantity := math.max(0, int(quantity))

// 6. Target calculations (RRR)
tp1  = osPrice + (osLossPerUnit * 1.0)
tp15 = osPrice + (osLossPerUnit * 1.5)
tp2  = osPrice + (osLossPerUnit * 2.0)
tp3  = osPrice + (osLossPerUnit * 3.0)

calcAssetTP(targetOS) =>
    osGainPct = (targetOS - osPrice) / osPrice
    move = (osGainPct / osHebel)
    tradeDir == "Long" ? currentAssetPrice * (1 + move) : currentAssetPrice * (1 - move)

// --- POSITION MAPPING ---
var string actualPos = switch tablePos
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    "Middle Right" => position.middle_right
    => position.top_right

// --- DYNAMIC DASHBOARD ---
var table mainTable = table.new(actualPos, 2, 11, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

if barstate.islast
    mainTable := table.new(actualPos, 2, 11, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)
    c_white = color.white
    c_gray  = color.gray
    
    // Row 0: Direction
    table.cell(mainTable, 0, 0, "Direction:", text_color=c_white, text_halign=text.align_left)
    table.cell(mainTable, 1, 0, tradeDir, text_color=tradeDir == "Long" ? color.lime : color.red)
    
    // Row 1: Quantity
    table.cell(mainTable, 0, 1, "Quantity:", text_color=c_white, text_halign=text.align_left)
    table.cell(mainTable, 1, 1, str.tostring(quantity, "#"), text_color=color.yellow)
    
    // Row 2: SL Mode
    table.cell(mainTable, 0, 2, "SL Mode:", text_color=c_white, text_halign=text.align_left)
    table.cell(mainTable, 1, 2, slMode, text_color=color.aqua)

    // Row 3: Asset SL
    table.cell(mainTable, 0, 3, "Asset SL Price:", text_color=c_white, text_halign=text.align_left)
    table.cell(mainTable, 1, 3, str.tostring(slAsset, "#.##"), text_color=color.orange)

    // Row 4: Warrant SL Order
    table.cell(mainTable, 0, 4, "Warrant SL Order:", text_color=c_white, text_halign=text.align_left)
    table.cell(mainTable, 1, 4, str.tostring(osSLPrice, "#.###"), text_color=color.orange)
    
    // Separator Row
    table.cell(mainTable, 0, 5, "--- Targets (OS) ---", text_color=c_gray, text_halign=text.align_left)
    table.cell(mainTable, 1, 5, "--- Asset Goal ---", text_color=c_gray)
    
    // TP Rows
    table.cell(mainTable, 0, 6, "TP 1.0 (1:1): " + str.tostring(tp1, "#.###"), text_color=c_white, text_halign=text.align_left)
    table.cell(mainTable, 1, 6, str.tostring(calcAssetTP(tp1), "#.##"), text_color=color.lime)
    table.cell(mainTable, 0, 7, "TP 1.5 (1.5:1): " + str.tostring(tp15, "#.###"), text_color=c_white, text_halign=text.align_left)
    table.cell(mainTable, 1, 7, str.tostring(calcAssetTP(tp15), "#.##"), text_color=color.lime)
    table.cell(mainTable, 0, 8, "TP 2.0 (2:1): " + str.tostring(tp2, "#.###"), text_color=c_white, text_halign=text.align_left)
    table.cell(mainTable, 1, 8, str.tostring(calcAssetTP(tp2), "#.##"), text_color=color.lime)
    table.cell(mainTable, 0, 9, "TP 3.0 (3:1): " + str.tostring(tp3, "#.###"), text_color=c_white, text_halign=text.align_left)
    table.cell(mainTable, 1, 9, str.tostring(calcAssetTP(tp3), "#.##"), text_color=color.lime)

// --- PLOT STOP LOSS LINE ---
// 1. Mark the price in the right scale
plot(slAsset, "Scale Label", color=color.red, style=plot.style_linebr, trackprice=true, show_last=1, display=display.price_scale)

// 2. Draw the dashed line and label extending to the right
var line slLine = line.new(na, na, na, na, xloc=xloc.bar_time, color=color.red, style=line.style_dashed, width=1)
var label slLabel = label.new(na, na, "SL", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=color.red, style=label.style_label_left, size=size.small)

if barstate.islast
    // Extend line to the right (about 30 bars distance)
    lineTimeEnd = time + (time - time[1]) * 30
    line.set_xy1(slLine, time, slAsset)
    line.set_xy2(slLine, lineTimeEnd, slAsset)
    
    // Position the label at the end of the line
    label.set_xy(slLabel, lineTimeEnd, slAsset)
