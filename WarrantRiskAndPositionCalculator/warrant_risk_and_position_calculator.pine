//@version=6
indicator("[ArtiShock] Universal Warrant Position Sizer (v1)", overlay=true)

// --- INPUTS ---
grp_trade = "Trade Direction"
tradeDir = input.string("Long", "Direction", options=["Long", "Short"], group=grp_trade)

grp_risk = "Risk & Fees"
maxRisk  = input.float(100.0, "Max. Risk Budget (Account Currency)", group=grp_risk)
fees     = input.float(1.0, "Fee per Order (Buy/Sell)", group=grp_risk)

grp_os = "Warrant / Derivative Data"
osPrice  = input.float(1.42, "Current Price (Ask/Buy)", group=grp_os)
osHebel  = input.float(15.0, "Leverage", group=grp_os)
osSpread = input.float(0.01, "Spread", group=grp_os)

grp_sl = "Stop-Loss Settings"
slAsset  = input.float(4526.0, "Asset Stop-Loss Price", group=grp_sl)

// --- CALCULATIONS ---
currentAssetPrice = close

// 1. Asset price movement in %
// If Long: Price must stay above SL. If Short: Price must stay below SL.
assetMovePct = tradeDir == "Long" ? (currentAssetPrice - slAsset) / currentAssetPrice : (slAsset - currentAssetPrice) / currentAssetPrice

// 2. Warrant price drop in % (Leverage effect)
// Note: assetMovePct is positive if trade is "alive", negative if SL is hit.
osDropPct = assetMovePct * osHebel

// 3. Stop-Loss Price for the Warrant
// We calculate the loss: if assetMovePct becomes negative, OS price drops.
osSLPrice = osPrice * (1 + (tradeDir == "Long" ? -1 : -1) * math.abs(assetMovePct) * osHebel) - osSpread
// Simplified for clarity:
osLossPerUnit = osPrice * (math.abs(assetMovePct) * osHebel) + osSpread

// 4. Available budget for price loss (minus 2x fees)
netRiskBudget = maxRisk - (2 * fees)

// 5. Optimal Position Size
quantity = math.floor(netRiskBudget / osLossPerUnit)

// 6. Target calculations (RRR)
tp1  = osPrice + (osLossPerUnit * 1.0)
tp2  = osPrice + (osLossPerUnit * 2.0)
tp3  = osPrice + (osLossPerUnit * 3.0)

calcAssetTP(targetOS) =>
    osGainPct = (targetOS - osPrice) / osPrice
    move = (osGainPct / osHebel)
    tradeDir == "Long" ? currentAssetPrice * (1 + move) : currentAssetPrice * (1 - move)

assetTP1 = calcAssetTP(tp1)
assetTP2 = calcAssetTP(tp2)
assetTP3 = calcAssetTP(tp3)

// --- DYNAMIC TABLE ---
var table mainTable = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

if barstate.islast
    c_white = color.white
    table.cell(mainTable, 0, 0, "Direction: " + tradeDir, text_color=tradeDir == "Long" ? color.lime : color.red)
    table.cell(mainTable, 1, 0, "Units: " + str.tostring(quantity, "#"), text_color=color.yellow)
    
    table.cell(mainTable, 0, 1, "Warrant SL:", text_color=c_white, text_halign=text.align_left)
    table.cell(mainTable, 1, 1, str.tostring(osSLPrice, "#.###"), text_color=color.orange)
    
    table.cell(mainTable, 0, 2, "--- TP Levels ---", text_color=color.gray)
    table.cell(mainTable, 1, 2, "--- Asset Target ---", text_color=color.gray)
    
    table.cell(mainTable, 0, 3, "TP 1 (1:1): " + str.tostring(tp1, "#.###"), text_color=c_white, text_halign=text.align_left)
    table.cell(mainTable, 1, 3, str.tostring(assetTP1, "#.##"), text_color=color.lime)
    
    table.cell(mainTable, 0, 4, "TP 2 (2:1): " + str.tostring(tp2, "#.###"), text_color=c_white, text_halign=text.align_left)
    table.cell(mainTable, 1, 4, str.tostring(assetTP2, "#.##"), text_color=color.lime)

plot(slAsset, "Asset SL Line", color=color.red, style=plot.style_linebr)
