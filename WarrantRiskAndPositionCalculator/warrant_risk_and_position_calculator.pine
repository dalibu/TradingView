//@version=6
indicator("[ArtiShock] Universal Warrant Position Calculator (v1)", overlay=true)

// --- INPUTS ---
grp_trade = "Trade Direction"
tradeDir = input.string("Long", "Direction", options=["Long", "Short"], group=grp_trade, tooltip="Select 'Long' for Call warrants (bullish) or 'Short' for Put warrants (bearish).")

grp_risk = "Risk & Fees"
maxRisk  = input.float(100.0, "Max. Risk Budget", group=grp_risk, tooltip="The maximum amount you are willing to lose in your account currency.")
fees     = input.float(1.0, "Fee per Order", group=grp_risk, tooltip="Broker fee per transaction (buy/sell).")

grp_os = "Warrant / Derivative Data"
osPrice  = input.float(1.0, "Warrant Price (Ask)", step=0.01, group=grp_os, tooltip="Your purchase price (Ask) - set once at entry.")
osHebel  = input.int(15, "Leverage", step=1, group=grp_os, tooltip="Current warrant leverage.")
osSpread = input.float(0.01, "Spread", step=0.01, group=grp_os, tooltip="Difference between Ask (buy) and Bid (sell) price.")

grp_sl = "Stop-Loss Settings"
slMode   = input.string("Manual", "SL Mode", options=["Manual", "ATR-Based"], group=grp_sl, tooltip="Choose between a fixed price or a volatility-based (ATR) Stop-Loss.")
entryManual = input.float(4575.0, "Manual Entry Price (Asset)", step=1, group=grp_sl, tooltip="Your entry price. Only used in Manual mode to keep lines static.")
slManual = input.float(4526.0, "Manual SL Price", group=grp_sl)
atrLen   = input.int(14, "ATR Length", step=1, minval=1, group=grp_sl)
atrMult  = input.float(1.5, "ATR Multiplier", step=0.1, group=grp_sl)

grp_ui = "User Interface"
tablePos = input.string("Top Right", "Dashboard Placement", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group=grp_ui)
textSize = input.string("Small", "Table Text Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group=grp_ui, tooltip="Adjust the font size of the dashboard table.")

// --- CALCULATIONS ---
currentAssetPrice = close
atrValue = ta.atr(atrLen)
timeDelta = ta.change(time)
lineTimeEnd = time + math.round(nz(timeDelta, 3600000) * 30) 

// 1. Calculate ATR History Path
atrHistoryValue = tradeDir == "Long" ? currentAssetPrice - (atrValue * atrMult) : currentAssetPrice + (atrValue * atrMult)
plot(slMode == "ATR-Based" ? atrHistoryValue : na, "ATR Path", color=color.red, linewidth=1, style=plot.style_linebr)

// 2. Determine Entry and SL strictly by Mode
float entryPrice = slMode == "Manual" ? entryManual : currentAssetPrice
float slAsset = slMode == "Manual" ? slManual : atrHistoryValue

// 3. Asset price movement in %
assetMovePct = math.abs(entryPrice - slAsset) / entryPrice

// 4. Warrant price calculations
osDropPct = assetMovePct * osHebel
osSLPriceAsk = osPrice * (1 - osDropPct)
osSLPrice = osSLPriceAsk - osSpread  // bid price at SL
osLossPerUnit = osPrice - osSLPrice

// Current warrant price: proportional to asset price change WITH leverage
currentAssetMovePct = (currentAssetPrice - entryPrice) / entryPrice
currentWarrantAsk = tradeDir == "Long" 
     ? osPrice * (1 + currentAssetMovePct * osHebel)
     : osPrice * (1 - currentAssetMovePct * osHebel)
currentWarrantBid = currentWarrantAsk - osSpread

// 5. Optimal Position Size
netRiskBudget = maxRisk - (2 * fees)
quantity = osLossPerUnit > 0 ? math.floor(netRiskBudget / osLossPerUnit) : 0
quantity := math.max(0, int(quantity))

// 6. Target calculations - Warrant TP based on geometric asset movement (1R, 2R, 3R)
tp1 = quantity > 0 ? osPrice * (1 + osDropPct * 1.0) : na
tp2 = quantity > 0 ? osPrice * (1 + osDropPct * 2.0) : na
tp3 = quantity > 0 ? osPrice * (1 + osDropPct * 3.0) : na

calcAssetTP(ratio) =>
    slDistance = math.abs(entryPrice - slAsset)
    tradeDir == "Long" ? entryPrice + (slDistance * ratio) : entryPrice - (slDistance * ratio)

assetTP1  = calcAssetTP(1.0)
assetTP2  = calcAssetTP(2.0)
assetTP3  = calcAssetTP(3.0)

// Helper: color Value cell relative to deposit
valColor(val, dep) =>
    val > dep ? color.lime : val < dep ? color.red : color.silver

// Helper: color Profit cell by sign
profitColor(p) =>
    p > 0 ? color.lime : p < 0 ? color.red : color.silver

// Helper: format profit string with percentage
formatProfitStr(p, dep) =>
    pct = dep > 0 ? (p / dep) * 100 : 0
    str.tostring(p, "#.##") + " (" + str.tostring(pct, "#.#") + "%)"

// --- MAPPING & UI ---
var string actualPos = switch tablePos
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    "Middle Right" => position.middle_right
    => position.top_right

var string actualSize = switch textSize
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large
    "Huge"   => size.huge
    => size.small

// --- DYNAMIC DASHBOARD ---
int numRows = slMode == "Manual" ? 10 : 9
var table mainTable = table.new(actualPos, 5, numRows, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

if barstate.islast
    mainTable := table.new(actualPos, 5, numRows, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)
    c_white = color.white
    c_gray  = color.gray
    c_orange = color.orange
    
    // ===== TITLE ROW =====
    table.cell(mainTable, 0, 0, "Warrant Position Calculator", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.blue, 70))
    table.merge_cells(mainTable, 0, 0, 4, 0)

    // ===== HEADER ROW =====
    table.cell(mainTable, 0, 1, "Direction", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 60))
    table.cell(mainTable, 1, 1, "Leverage", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 60))
    table.cell(mainTable, 2, 1, "Ask", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 60))
    table.cell(mainTable, 3, 1, "Quantity", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 60))
    table.cell(mainTable, 4, 1, "Deposit", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 60))
    
    // ===== ENTRY ROW =====
    entry_color = tradeDir == "Long" ? color.lime : color.red
    deposit = quantity * osPrice
    direction_icon = tradeDir == "Long" ? "↑" : "↓"
    table.cell(mainTable, 0, 2, tradeDir + " " + direction_icon, text_color=entry_color, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 1, 2, str.tostring(osHebel, "#") + "x", text_color=color.silver, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 2, 2, str.tostring(osPrice, "#.###"), text_color=color.silver, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 3, 2, str.tostring(quantity, "#"), text_color=color.yellow, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 4, 2, str.tostring(deposit, "#.##"), text_color=color.silver, text_halign=text.align_center, text_size=actualSize)
    
    // ===== LABELS ROW (RRR) =====
    table.cell(mainTable, 0, 3, "RRR", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 80))
    table.cell(mainTable, 1, 3, "Asset", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 80))
    table.cell(mainTable, 2, 3, "Bid", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 80))
    table.cell(mainTable, 3, 3, "Value", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 80))
    table.cell(mainTable, 4, 3, "Profit", text_color=color.white, text_halign=text.align_center, text_size=actualSize, bgcolor=color.new(color.gray, 80))
    
    // Determine row positions based on direction and SL mode
    // In ATR mode the entry (→) row is hidden → table has 8 rows, indices shift
    int rowSL = na
    int rowActual = na
    int rowTP1 = na
    int rowTP2 = na
    int rowTP3 = na
    int rowEntry = na

    bool isManual = slMode == "Manual"

    if tradeDir == "Long"
        rowTP3 := 4
        rowTP2 := 5
        rowTP1 := 6
        if isManual
            rowEntry  := 7
            rowActual := 8
            rowSL     := 9
        else
            rowActual := 7
            rowSL     := 8
    else  // Short
        rowSL := 4
        if isManual
            rowEntry  := 5
            rowActual := 6
            rowTP1    := 7
            rowTP2    := 8
            rowTP3    := 9
        else
            rowActual := 5
            rowTP1    := 6
            rowTP2    := 7
            rowTP3    := 8

    // ===== ENTRY - arrow row (Manual mode only) =====
    entry_bid = osPrice - osSpread
    entry_bid_value = entry_bid * quantity
    entry_profit = entry_bid_value - deposit - (2 * fees)
    if isManual
        table.cell(mainTable, 0, rowEntry, "→", text_color=color.silver, text_halign=text.align_center, text_size=actualSize)
        table.cell(mainTable, 1, rowEntry, str.tostring(entryPrice, "#.##"), text_color=color.silver, text_halign=text.align_center, text_size=actualSize)
        table.cell(mainTable, 2, rowEntry, str.tostring(entry_bid, "#.###"), text_color=color.silver, text_halign=text.align_center, text_size=actualSize)
        table.cell(mainTable, 3, rowEntry, str.tostring(entry_bid_value, "#.##"), text_color=valColor(entry_bid_value, deposit), text_halign=text.align_center, text_size=actualSize)
        table.cell(mainTable, 4, rowEntry, formatProfitStr(entry_profit, deposit), text_color=profitColor(entry_profit), text_halign=text.align_center, text_size=actualSize)

    // ===== ACTUAL - dynamic values based on current asset price =====
    actualValue = currentWarrantBid * quantity
    actualProfit = actualValue - deposit - (2 * fees)
    actual_color = currentWarrantBid >= osPrice - osSpread ? color.white : color.orange
    value_color = valColor(actualValue, deposit)
    profit_color = profitColor(actualProfit)
    table.cell(mainTable, 0, rowActual, "Actual", text_color=actual_color, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 1, rowActual, str.tostring(currentAssetPrice, "#.##"), text_color=actual_color, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 2, rowActual, str.tostring(currentWarrantBid, "#.###"), text_color=actual_color, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 3, rowActual, str.tostring(actualValue, "#.##"), text_color=value_color, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 4, rowActual, formatProfitStr(actualProfit, deposit), text_color=profit_color, text_halign=text.align_center, text_size=actualSize)

    // ===== STOP LOSS ROW =====
    slBid = osSLPriceAsk - osSpread
    slValue = slBid * quantity
    slProfit = slValue - deposit - (2 * fees)
    slLabel = slMode == "Manual" ? "SL (Manual)" : "SL (ATR x" + str.tostring(atrMult, "#.#") + ")"
    table.cell(mainTable, 0, rowSL, slLabel, text_color=color.red, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 1, rowSL, str.tostring(slAsset, "#.##"), text_color=color.red, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 2, rowSL, str.tostring(slBid, "#.###"), text_color=color.red, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 3, rowSL, str.tostring(slValue, "#.##"), text_color=valColor(slValue, deposit), text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 4, rowSL, formatProfitStr(slProfit, deposit), text_color=profitColor(slProfit), text_halign=text.align_center, text_size=actualSize)
    
    // ===== TP 1:1 ROW =====
    tp1Bid = tp1 - osSpread
    tp1Value = tp1Bid * quantity
    tp1Profit = tp1Value - deposit - (2 * fees)
    table.cell(mainTable, 0, rowTP1, "TP 1:1", text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 1, rowTP1, str.tostring(assetTP1, "#.##"), text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 2, rowTP1, str.tostring(tp1Bid, "#.###"), text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 3, rowTP1, str.tostring(tp1Value, "#.##"), text_color=valColor(tp1Value, deposit), text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 4, rowTP1, formatProfitStr(tp1Profit, deposit), text_color=profitColor(tp1Profit), text_halign=text.align_center, text_size=actualSize)

    // ===== TP 2:1 ROW =====
    tp2Bid = tp2 - osSpread
    tp2Value = tp2Bid * quantity
    tp2Profit = tp2Value - deposit - (2 * fees)
    table.cell(mainTable, 0, rowTP2, "TP 2:1", text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 1, rowTP2, str.tostring(assetTP2, "#.##"), text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 2, rowTP2, str.tostring(tp2Bid, "#.###"), text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 3, rowTP2, str.tostring(tp2Value, "#.##"), text_color=valColor(tp2Value, deposit), text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 4, rowTP2, formatProfitStr(tp2Profit, deposit), text_color=profitColor(tp2Profit), text_halign=text.align_center, text_size=actualSize)

    // ===== TP 3:1 ROW =====
    tp3Bid = tp3 - osSpread
    tp3Value = tp3Bid * quantity
    tp3Profit = tp3Value - deposit - (2 * fees)
    table.cell(mainTable, 0, rowTP3, "TP 3:1", text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 1, rowTP3, str.tostring(assetTP3, "#.##"), text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 2, rowTP3, str.tostring(tp3Bid, "#.###"), text_color=color.lime, text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 3, rowTP3, str.tostring(tp3Value, "#.##"), text_color=valColor(tp3Value, deposit), text_halign=text.align_center, text_size=actualSize)
    table.cell(mainTable, 4, rowTP3, formatProfitStr(tp3Profit, deposit), text_color=profitColor(tp3Profit), text_halign=text.align_center, text_size=actualSize)

// --- VISUAL LINES ---

plot(slAsset, "Scale Label", color=color.red, style=plot.style_linebr, trackprice=true, show_last=1)
plot(slMode == "Manual" ? entryPrice : na, "Entry Scale Label", color=color.silver, style=plot.style_linebr, trackprice=true, show_last=1)

updateVisuals(lineObj, labelObj, price, txt, lColor, endTime) =>
    line.set_xy1(lineObj, time, price)
    line.set_xy2(lineObj, endTime, price)
    label.set_xy(labelObj, endTime, price)
    label.set_text(labelObj, txt)
    label.set_textcolor(labelObj, lColor)

var slLine = line.new(na, na, na, na, xloc=xloc.bar_time, color=color.red, style=line.style_dashed, width=1)
var slLabel = label.new(na, na, "SL", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=color.red, style=label.style_label_left, size=size.small)

var entryLine = line.new(na, na, na, na, xloc=xloc.bar_time, color=color.silver, style=line.style_dashed, width=1)
var entryLabel = label.new(na, na, "Entry", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=color.silver, style=label.style_label_left, size=size.small)

var tp1Line = line.new(na, na, na, na, xloc=xloc.bar_time, color=color.lime, style=line.style_dashed, width=1)
var tp1Label = label.new(na, na, "TP 1", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=color.lime, style=label.style_label_left, size=size.small)

var tp2Line = line.new(na, na, na, na, xloc=xloc.bar_time, color=color.lime, style=line.style_dashed, width=1)
var tp2Label = label.new(na, na, "TP 2", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=color.lime, style=label.style_label_left, size=size.small)

var tp3Line = line.new(na, na, na, na, xloc=xloc.bar_time, color=color.lime, style=line.style_dashed, width=1)
var tp3Label = label.new(na, na, "TP 3", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=color.lime, style=label.style_label_left, size=size.small)

if barstate.islast
    updateVisuals(slLine, slLabel, slAsset, "SL", color.red, lineTimeEnd)
    updateVisuals(entryLine, entryLabel, slMode == "Manual" ? entryPrice : na, "Entry", color.silver, lineTimeEnd)
    updateVisuals(tp1Line, tp1Label, assetTP1, "TP 1", color.lime, lineTimeEnd)
    updateVisuals(tp2Line, tp2Label, assetTP2, "TP 2", color.lime, lineTimeEnd)
    updateVisuals(tp3Line, tp3Label, assetTP3, "TP 3", color.lime, lineTimeEnd)
