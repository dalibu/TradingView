//@version=6
indicator("EMA 9 + VWAP Cross (v1 + статистика)", overlay=true, max_labels_count=500)

// ───────── Настройки (как в v1) ─────────
grpEma  = "EMA"
emaLen  = input.int(9, "Длина EMA", minval=1, group=grpEma)
emaSrc  = input.source(close, "Источник EMA", group=grpEma)

grpVwap = "VWAP"
vwapSrc = input.source(ohlc4, "Источник VWAP (OHLC4)", group=grpVwap)
rthOnly = input.bool(true, "Считать VWAP только по сессии", group=grpVwap)

grpSess = "Сессия / фильтры"
sessStr = input.string("0930-1600", "Сессия", group=grpSess)
tzStr   = input.string("America/New_York", "Часовой пояс", group=grpSess)
limitWin = input.bool(false, "Торговать только первые N минут после открытия", group=grpSess)
winMin   = input.int(120, "N минут", minval=1, group=grpSess)
useAdx   = input.bool(false, "ADX-фильтр (против чопа)", group=grpSess)
adxLen   = input.int(14, "ADX длина", group=grpSess)
adxMin   = input.int(20, "ADX минимум", group=grpSess)

grpExit = "Выход"
stopPct = input.float(0.0, "Стоп по базовому активу, % (0 = выкл.)", minval=0.0, step=0.05, group=grpExit)
exitEOD = input.bool(true, "Закрывать в конце сессии", group=grpExit)

grpStat = "Статистика"
showTbl  = input.bool(true, "Показывать таблицу", group=grpStat)
unitStr  = input.string("Пункты цены", "Единицы результата", options=["Пункты цены", "% от цены входа"], group=grpStat)
costPts  = input.float(0.0, "Издержки на сделку (спред/комиссия), пункты цены", minval=0.0, step=0.001, group=grpStat)
tblPosStr = input.string("Верх справа", "Положение таблицы", options=["Верх справа", "Верх слева", "Низ справа", "Низ слева"], group=grpStat)

// ───────── Расчёты ─────────
ema = ta.ema(emaSrc, emaLen)

inRTH   = not na(time(timeframe.period, sessStr, tzStr))
newSess = inRTH and not inRTH[1]

var float cumPV = 0.0
var float cumV  = 0.0
var int   sessStartTime = na
if newSess
    cumPV := 0.0
    cumV  := 0.0
    sessStartTime := time
if inRTH
    cumPV += vwapSrc * volume
    cumV  += volume

float vwapRth = cumV > 0 ? cumPV / cumV : na
float vwapDay = ta.vwap(vwapSrc, timeframe.change("D"))
float vwap    = rthOnly ? (inRTH ? vwapRth : na) : vwapDay

float minsFromOpen = (inRTH and not na(sessStartTime)) ? (time - sessStartTime) / 60000.0 : na
bool inWindow = not limitWin or (not na(minsFromOpen) and minsFromOpen <= winMin)

[_, _, adxVal] = ta.dmi(adxLen, adxLen)
bool adxOk = not useAdx or adxVal >= adxMin

bool canTrade = (not rthOnly or inRTH) and inWindow and adxOk

// ───────── Сигналы входа ─────────
bool longEntry  = ta.crossover(ema, vwap)  and canTrade
bool shortEntry = ta.crossunder(ema, vwap) and canTrade

// ───────── Статистика: переменные ─────────
var int   nTr = 0
var int   nWin = 0
var int   nLoss = 0
var int   nLong = 0
var int   nShort = 0
var int   winLong = 0
var int   winShort = 0
var float grossP = 0.0
var float grossL = 0.0
var float sumPnl = 0.0
var float equity = 0.0
var float peak = 0.0
var float maxDD = 0.0
var float bestTr = na
var float worstTr = na
var int   loseStreak = 0
var int   maxLoseStreak = 0
var int   sumBars = 0
var int   entryBar = 0

// ───────── Ведение позиции и выход ─────────
var int   pos = 0
var float entryPrice = na

bool exitLong  = false
bool exitShort = false
float exitPx = na

if pos == 1
    bool byEma  = close < ema
    bool byStop = stopPct > 0 and low <= entryPrice * (1 - stopPct / 100)
    bool byEod  = exitEOD and inRTH[1] and not inRTH
    exitLong := byEma or byStop or byEod
    if exitLong
        exitPx := byStop ? entryPrice * (1 - stopPct / 100) : (byEma ? close : close[1])
if pos == -1
    bool byEma  = close > ema
    bool byStop = stopPct > 0 and high >= entryPrice * (1 + stopPct / 100)
    bool byEod  = exitEOD and inRTH[1] and not inRTH
    exitShort := byEma or byStop or byEod
    if exitShort
        exitPx := byStop ? entryPrice * (1 + stopPct / 100) : (byEma ? close : close[1])

if exitLong or exitShort
    float dir = pos
    float pnlPts = dir * (exitPx - entryPrice) - costPts
    float pnl = unitStr == "% от цены входа" ? pnlPts / entryPrice * 100 : pnlPts
    nTr += 1
    sumPnl += pnl
    equity += pnl
    peak := math.max(peak, equity)
    maxDD := math.max(maxDD, peak - equity)
    bestTr := na(bestTr) ? pnl : math.max(bestTr, pnl)
    worstTr := na(worstTr) ? pnl : math.min(worstTr, pnl)
    sumBars += bar_index - entryBar
    if pnl > 0
        nWin += 1
        grossP += pnl
        loseStreak := 0
    else
        nLoss += 1
        grossL += -pnl
        loseStreak += 1
        maxLoseStreak := math.max(maxLoseStreak, loseStreak)
    if pos == 1
        nLong += 1
        winLong += pnl > 0 ? 1 : 0
    else
        nShort += 1
        winShort += pnl > 0 ? 1 : 0
    pos := 0
    entryPrice := na

bool enterLong = false
bool enterShort = false
if pos == 0
    if longEntry
        pos := 1
        entryPrice := close
        entryBar := bar_index
        enterLong := true
    else if shortEntry
        pos := -1
        entryPrice := close
        entryBar := bar_index
        enterShort := true

// ───────── Отрисовка ─────────
plot(ema,  "EMA 9", color=color.new(color.orange, 0), linewidth=2)
plot(vwap, "VWAP",  color=color.new(color.aqua, 0),   linewidth=2)

plotshape(enterLong,  "CALL вход", style=shape.labelup,   location=location.belowbar,
     color=color.new(color.green, 0), textcolor=color.white, text="CALL", size=size.small)
plotshape(enterShort, "PUT вход",  style=shape.labeldown, location=location.abovebar,
     color=color.new(color.red, 0),   textcolor=color.white, text="PUT",  size=size.small)
plotshape(exitLong,   "Выход из лонга",  style=shape.xcross, location=location.abovebar,
     color=color.new(color.gray, 0), size=size.tiny, text="exit")
plotshape(exitShort,  "Выход из шорта",  style=shape.xcross, location=location.belowbar,
     color=color.new(color.gray, 0), size=size.tiny, text="exit")

bgcolor(pos == 1 ? color.new(color.green, 92) : pos == -1 ? color.new(color.red, 92) : na)

// ───────── Таблица статистики ─────────
tblPosition = switch tblPosStr
    "Верх справа" => position.top_right
    "Верх слева"  => position.top_left
    "Низ справа"  => position.bottom_right
    => position.bottom_left

var table t = table.new(tblPosition, 2, 17, bgcolor=color.new(color.black, 15), border_width=1, frame_color=color.gray, frame_width=1)

f_row(table tbl, int r, string a, string b, color c) =>
    table.cell(tbl, 0, r, a, text_color=color.silver, text_halign=text.align_left, text_size=size.small)
    table.cell(tbl, 1, r, b, text_color=c, text_halign=text.align_right, text_size=size.small)

f_num(float v) =>
    na(v) ? "-" : (unitStr == "% от цены входа" ? str.tostring(v, "#.00") + "%" : str.tostring(v, "#.####"))

f_pct(int a, int b) =>
    b > 0 ? str.tostring(100.0 * a / b, "#.0") + "%" : "-"

if showTbl and barstate.islast
    float avgWin = nWin > 0 ? grossP / nWin : na
    float avgLoss = nLoss > 0 ? grossL / nLoss : na
    float payoff = (not na(avgWin) and not na(avgLoss) and avgLoss > 0) ? avgWin / avgLoss : na
    float pf = grossL > 0 ? grossP / grossL : na
    float expct = nTr > 0 ? sumPnl / nTr : na
    string wl = str.tostring(nWin) + " / " + str.tostring(nLoss)

    f_row(t, 0,  "Единицы", unitStr == "% от цены входа" ? "% от входа" : "пункты цены", color.white)
    f_row(t, 1,  "Сделок", str.tostring(nTr), color.white)
    f_row(t, 2,  "Приб. / убыт.", wl, color.white)
    f_row(t, 3,  "Winrate", f_pct(nWin, nTr), color.white)
    f_row(t, 4,  "Итого (net)", f_num(sumPnl), sumPnl >= 0 ? color.lime : color.red)
    f_row(t, 5,  "Матожидание / сделку", f_num(expct), nz(expct) >= 0 ? color.lime : color.red)
    f_row(t, 6,  "Ср. прибыль", f_num(avgWin), color.lime)
    f_row(t, 7,  "Ср. убыток", f_num(na(avgLoss) ? na : -avgLoss), color.red)
    f_row(t, 8,  "Payoff (приб./убыт.)", na(payoff) ? "-" : str.tostring(payoff, "#.00"), color.white)
    f_row(t, 9,  "Profit factor", na(pf) ? "-" : str.tostring(pf, "#.00"), nz(pf) >= 1 ? color.lime : color.red)
    f_row(t, 10, "Лучшая сделка", f_num(bestTr), color.lime)
    f_row(t, 11, "Худшая сделка", f_num(worstTr), color.red)
    f_row(t, 12, "Макс. просадка", f_num(-maxDD), color.red)
    f_row(t, 13, "Макс. серия убытков", str.tostring(maxLoseStreak), color.white)
    f_row(t, 14, "Лонг: сделок / winrate", str.tostring(nLong) + " / " + f_pct(winLong, nLong), color.white)
    f_row(t, 15, "Шорт: сделок / winrate", str.tostring(nShort) + " / " + f_pct(winShort, nShort), color.white)
    f_row(t, 16, "Ср. длит., свечей", nTr > 0 ? str.tostring(1.0 * sumBars / nTr, "#.0") : "-", color.white)

// ───────── Алерты ─────────
alertcondition(enterLong,  "CALL сигнал", "EMA9 пересекла VWAP вверх — CALL")
alertcondition(enterShort, "PUT сигнал",  "EMA9 пересекла VWAP вниз — PUT")
alertcondition(exitLong or exitShort, "Выход", "Выход из позиции (закрытие за EMA9 / стоп / конец сессии)")
