//@version=6
indicator("EMA 9 + VWAP Cross v2 (filtered)", overlay=true, max_labels_count=500)

// ───────── Настройки ─────────
emaLen   = input.int(9, "Длина EMA", minval=1, group="EMA / VWAP")
vwapSrc  = input.source(ohlc4, "Источник VWAP", group="EMA / VWAP")

sessStr  = input.string("0930-1600", "RTH сессия", group="Сессия")
tzStr    = input.string("America/New_York", "Часовой пояс", group="Сессия")
winMin   = input.int(60, "Торговать N минут после открытия (0 = весь день)", minval=0, group="Сессия")

atrLen   = input.int(14, "ATR длина", group="Фильтры")
useAdx   = input.bool(true, "ADX фильтр", group="Фильтры")
adxLen   = input.int(14, "ADX длина", group="Фильтры")
adxMin   = input.int(36, "ADX минимум (в видео 36)", group="Фильтры")
useChop  = input.bool(true, "Счётчик чопа: пересечения close/VWAP", group="Фильтры")
chopLen  = input.int(20, "Окно (свечей)", group="Фильтры")
maxCross = input.int(2, "Макс. пересечений VWAP в окне", group="Фильтры")
minDist  = input.float(0.15, "Мин. расстояние close от VWAP, × ATR", step=0.05, group="Фильтры")

atrMult  = input.float(1.5, "Стоп, × ATR", step=0.1, group="Риск / выход")
rr       = input.float(3.0, "Цель, R", step=0.5, group="Риск / выход")
useEma   = input.bool(false, "Доп. выход: закрытие за EMA 9", group="Риск / выход")
cooldown = input.int(5, "Пауза после выхода, свечей", minval=0, group="Риск / выход")
maxTrd   = input.int(3, "Макс. сделок в день", minval=1, group="Риск / выход")
dayLossR = input.float(2.0, "Дневной лимит убытка, R", step=0.5, group="Риск / выход")

showTbl  = input.bool(true, "Таблица статистики", group="Вид")

// ───────── Расчёты ─────────
ema = ta.ema(close, emaLen)
atr = ta.atr(atrLen)

inRTH   = not na(time(timeframe.period, sessStr, tzStr))
newSess = inRTH and not inRTH[1]

var float cumPV = 0.0
var float cumV  = 0.0
var int   sessStart = 0
var float dayR = 0.0
var int   dayTrades = 0
if newSess
    cumPV := 0.0
    cumV  := 0.0
    sessStart := time
    dayR := 0.0
    dayTrades := 0
if inRTH
    cumPV += vwapSrc * volume
    cumV  += volume

float vwap = (inRTH and cumV > 0) ? cumPV / cumV : na

float mins = inRTH ? (time - sessStart) / 60000.0 : na
bool inWin = inRTH and (winMin == 0 or mins <= winMin)

[_, _, adxVal] = ta.dmi(adxLen, adxLen)
bool adxOk = not useAdx or adxVal >= adxMin

float crossFlag = ta.cross(close, vwap) ? 1.0 : 0.0
bool chopOk = not useChop or math.sum(crossFlag, chopLen) <= maxCross

// ───────── Состояние сделки ─────────
var int   pos = 0
var float entryPrice = na
var float stopP = na
var float tpP = na
var float riskD = na
var int   lastExitBar = -1000
var int   nTrades = 0
var int   nWins = 0
var float totalR = 0.0

bool exitFlag = false
float resR = 0.0
bool wasLong = pos == 1

if pos != 0
    float dir = pos
    bool hitStop = pos == 1 ? low <= stopP : high >= stopP
    bool hitTp   = pos == 1 ? high >= tpP  : low <= tpP
    bool emaX    = useEma and (pos == 1 ? close < ema : close > ema)
    bool eod     = inRTH[1] and not inRTH
    if hitStop
        exitFlag := true
        resR := -1.0
    else if hitTp
        exitFlag := true
        resR := rr
    else if emaX
        exitFlag := true
        resR := dir * (close - entryPrice) / riskD
    else if eod
        exitFlag := true
        resR := dir * (close[1] - entryPrice) / riskD

if exitFlag
    pos := 0
    nTrades += 1
    nWins += resR > 0 ? 1 : 0
    totalR += resR
    dayR += resR
    lastExitBar := bar_index

// ───────── Сигналы входа ─────────
bool baseOk = inWin and adxOk and chopOk and not na(vwap) and not na(atr)
bool limitsOk = dayTrades < maxTrd and dayR > -dayLossR and (bar_index - lastExitBar) > cooldown

bool longSig  = ta.crossover(ema, vwap)  and close > vwap + minDist * atr
bool shortSig = ta.crossunder(ema, vwap) and close < vwap - minDist * atr

bool enterLong = false
bool enterShort = false
if pos == 0 and not exitFlag and baseOk and limitsOk
    if longSig
        enterLong := true
        pos := 1
    else if shortSig
        enterShort := true
        pos := -1
    if pos != 0
        entryPrice := close
        riskD := atrMult * atr
        stopP := close - pos * riskD
        tpP   := close + pos * rr * riskD
        dayTrades += 1

// ───────── Отрисовка ─────────
plot(ema,  "EMA 9", color=color.orange, linewidth=2)
plot(vwap, "VWAP",  color=color.aqua,   linewidth=2)
plot(pos != 0 ? stopP : na, "Стоп", color=color.new(color.red, 20),   style=plot.style_linebr)
plot(pos != 0 ? tpP   : na, "Цель", color=color.new(color.green, 20), style=plot.style_linebr)

plotshape(enterLong,  "CALL", style=shape.labelup,   location=location.belowbar, color=color.green, textcolor=color.white, text="CALL", size=size.small)
plotshape(enterShort, "PUT",  style=shape.labeldown, location=location.abovebar, color=color.red,   textcolor=color.white, text="PUT",  size=size.small)
plotshape(exitFlag and resR > 0,  "Выход +", style=shape.xcross, location=location.abovebar, color=color.green, size=size.tiny)
plotshape(exitFlag and resR <= 0, "Выход -", style=shape.xcross, location=location.abovebar, color=color.red,   size=size.tiny)

bgcolor(inRTH and not chopOk ? color.new(color.gray, 90) : na, title="Чоп")

// ───────── Таблица ─────────
var table t = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 20), border_width=1)
if showTbl and barstate.islast
    table.cell(t, 0, 0, "Сделок",   text_color=color.white)
    table.cell(t, 1, 0, str.tostring(nTrades), text_color=color.white)
    table.cell(t, 0, 1, "Winrate",  text_color=color.white)
    table.cell(t, 1, 1, nTrades > 0 ? str.tostring(100.0 * nWins / nTrades, "#.0") + "%" : "-", text_color=color.white)
    table.cell(t, 0, 2, "Итого R",  text_color=color.white)
    table.cell(t, 1, 2, str.tostring(totalR, "#.0"), text_color=totalR >= 0 ? color.lime : color.red)
    table.cell(t, 0, 3, "R сегодня", text_color=color.white)
    table.cell(t, 1, 3, str.tostring(dayR, "#.0"), text_color=dayR >= 0 ? color.lime : color.red)

// ───────── Алерты ─────────
alertcondition(enterLong,  "CALL сигнал", "EMA9 > VWAP: CALL (фильтры пройдены)")
alertcondition(enterShort, "PUT сигнал",  "EMA9 < VWAP: PUT (фильтры пройдены)")
alertcondition(exitFlag,   "Выход",       "Выход из позиции")
