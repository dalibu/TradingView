//@version=6
strategy(
     title="XAUUSD Long Scalper",
     shorttitle="XAUUSD Long",
     overlay=true,
     initial_capital=10000,
     currency=currency.USD,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.1,
     slippage=1,
     pyramiding=0,
     calc_on_order_fills=true,
     calc_on_every_tick=false)

groupGeneral = "Allgemein"
groupEntry = "Entry"
groupRisk = "Risk"
groupVisual = "Visuals"

startDate = input.time(timestamp("2025-05-01T00:00:00"), "Backtest Start", group=groupGeneral)
sessionInput = input.session("0700-1900", "Handelszeit", group=groupGeneral)
useSessionFilter = input.bool(true, "Nur Session handeln", group=groupGeneral)

fastEmaLength = input.int(20, "Fast EMA", minval=1, group=groupEntry)
slowEmaLength = input.int(50, "Slow EMA", minval=1, group=groupEntry)
trendEmaLength = input.int(200, "Trend EMA", minval=1, group=groupEntry)
rsiLength = input.int(14, "RSI Length", minval=1, group=groupEntry)
rsiMin = input.int(52, "RSI Minimum", minval=1, maxval=99, group=groupEntry)
adxLength = input.int(14, "ADX Length", minval=1, group=groupEntry)
adxMin = input.int(18, "ADX Minimum", minval=1, group=groupEntry)
breakoutLength = input.int(6, "Breakout Lookback", minval=2, group=groupEntry)

swingLookback = input.int(5, "Swing Low Lookback", minval=2, group=groupRisk)
atrLength = input.int(14, "ATR Length", minval=1, group=groupRisk)
atrStopMult = input.float(0.6, "ATR Buffer unter Swing Low", minval=0.1, step=0.1, group=groupRisk)
riskReward = input.float(1.8, "Take Profit RR", minval=0.5, step=0.1, group=groupRisk)
useBreakEven = input.bool(true, "Break Even aktiv", group=groupRisk)
breakEvenAfterR = input.float(1.0, "Break Even ab R", minval=0.5, step=0.1, group=groupRisk)

showLevels = input.bool(true, "SL/TP anzeigen", group=groupVisual)
showSignals = input.bool(true, "Signale anzeigen", group=groupVisual)

inDateRange = time >= startDate
inSession = not na(time(timeframe.period, sessionInput))
tradeWindow = inDateRange and (not useSessionFilter or inSession)

fastEma = ta.ema(close, fastEmaLength)
slowEma = ta.ema(close, slowEmaLength)
trendEma = ta.ema(close, trendEmaLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)
[diplus, diminus, adxValue] = ta.dmi(adxLength, adxLength)

trendUp = close > trendEma and fastEma > slowEma and slowEma > trendEma
pullbackHeld = low <= fastEma and close > fastEma
bullishCandle = close > open and close > high[1]
breakout = close > ta.highest(high, breakoutLength)[1]
momentumOk = rsiValue >= rsiMin and adxValue >= adxMin and diplus > diminus

setupSignal = tradeWindow and barstate.isconfirmed and trendUp and pullbackHeld and bullishCandle and breakout and momentumOk
longSignal = setupSignal[1]

var float activeStop = na
var float activeTarget = na
var float initialRisk = na
var float pendingStop = na
var bool pendingEntry = false

rawSwingLow = ta.lowest(low[1], swingLookback)
logicStop = rawSwingLow - atrValue * atrStopMult

if longSignal and strategy.position_size == 0 and not pendingEntry
    pendingStop := logicStop[1]
    pendingEntry := not na(pendingStop)
    if pendingEntry
        strategy.entry("Long", strategy.long)

newPositionOpened = strategy.position_size > 0 and strategy.position_size[1] == 0
if newPositionOpened and pendingEntry and not na(pendingStop)
    avgEntry = strategy.position_avg_price
    activeStop := math.min(avgEntry - syminfo.mintick, pendingStop)
    initialRisk := avgEntry - activeStop
    activeTarget := initialRisk > syminfo.mintick ? avgEntry + initialRisk * riskReward : na
    pendingEntry := false
    pendingStop := na

if strategy.position_size > 0 and not na(activeStop) and not na(initialRisk)
    avgEntry = strategy.position_avg_price
    openProfit = close - avgEntry
    breakEvenStop = avgEntry + syminfo.mintick
    moveToBreakEven = useBreakEven and openProfit >= initialRisk * breakEvenAfterR
    exitStop = moveToBreakEven ? math.max(activeStop, breakEvenStop) : activeStop
    trendFailExit = ta.crossunder(close, slowEma) or ta.crossunder(rsiValue, 45)
    strategy.exit("Long Exit", "Long", stop=exitStop, limit=activeTarget)
    if trendFailExit
        strategy.close("Long", comment="Trend Exit")

if strategy.position_size == 0
    activeStop := na
    activeTarget := na
    initialRisk := na
    if not pendingEntry
        pendingStop := na

plot(fastEma, "EMA 20", color=color.new(color.orange, 0), linewidth=2)
plot(slowEma, "EMA 50", color=color.new(color.blue, 0), linewidth=2)
plot(trendEma, "EMA 200", color=color.new(color.teal, 0), linewidth=2)

plot(showLevels and strategy.position_size > 0 ? activeStop : na, "Logic SL", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
plot(showLevels and strategy.position_size > 0 ? activeTarget : na, "TP", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)

plotshape(showSignals and setupSignal, title="Setup Signal", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), text="Setup", textcolor=color.white, size=size.tiny)
plotshape(showSignals and longSignal, title="Entry Signal", style=shape.circle, location=location.belowbar, color=color.new(color.lime, 0), size=size.tiny)
