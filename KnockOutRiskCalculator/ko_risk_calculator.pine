//@version=6
indicator("Knock-Out Risk Calculator", shorttitle="KO Risk Calc", overlay=true, max_lines_count=20, max_labels_count=20, max_boxes_count=10)

// ════════════════════════════════════════════════════════════════
//  Knock-Out (Turbo) certificate risk calculator
//  - Click Entry / Stop / Target on the chart when adding the indicator
//    (they can be dragged afterwards, as in "Future Risk Calculator")
//  - Enter the certificate data (strike, KO, multiplier, spread)
//  - Table (top right) + labels show pieces, SL price of the certificate,
//    loss / profit in EUR, R:R, leverage and warnings
//  Price model: (S - Strike) * Mult / FX   (Long)
//               (Strike - S) * Mult / FX   (Short)
// ════════════════════════════════════════════════════════════════

G1 = "1. Position (click on chart)"
G2 = "2. Knock-out product (from finanzen.net / broker)"
G3 = "3. Risk"
G4 = "4. Display"

// ── 1. Position ─────────────────────────────────────────────────
dirStr   = input.string("Auto (from levels)", "Direction", options=["Auto (from levels)", "Long (Turbo Long / Call)", "Short (Turbo Short / Put)"], group=G1, tooltip="Auto: Long if Target is above Entry, Short if Target is below Entry. Drag the three dots on the chart to flip the trade.")
entryP   = input.price(0.0, "Entry (underlying)", confirm=true, group=G1)
stopIn   = input.price(0.0, "Stop (underlying)", confirm=true, group=G1)
tpP      = input.price(0.0, "Target (underlying)", confirm=true, group=G1)
stopMode = input.string("Manual (as set on chart)", "Stop mode", options=["Manual (as set on chart)", "Auto: from budget & max loss"], group=G1, tooltip="Auto: the script calculates the stop level of the underlying so that buying for the whole budget loses exactly the max loss at the stop.")

// ── 2. Product ──────────────────────────────────────────────────
koLvl      = input.float(1.5819, "Knock-Out barrier", step=0.0001, group=G2)
prodLbl   = input.string("", "Label / WKN (shown in table header)", group=G2, tooltip="Free text, e.g. the WKN. Helps to tell several instances of this indicator apart (one per certificate).")
sameStr    = input.bool(true, "Strike = Knock-Out barrier (normal Turbo)", group=G2, tooltip="Tick for a classic Turbo (strike and KO are equal). Untick for Mini Future / Stop-Loss products and enter the Strike (financing level) separately below.")
strikeIn   = input.float(1.5819, "Strike (used only if the box above is unticked)", step=0.0001, group=G2)
mult       = input.float(100.0, "Multiplier (price = (S-Strike) x Mult / FX)", minval=0.0001, group=G2, tooltip="finanzen.net: 'Preis = (Kurs - Strike) * 100'. Put the number after the '*' here.")
fxMode     = input.string("Underlying is EUR/XXX (divide by price)", "Currency conversion to EUR", options=["Underlying is EUR/XXX (divide by price)", "Live rate from symbol (XXX per 1 EUR)", "Fixed rate (XXX per 1 EUR)", "Price already in EUR"], group=G2, tooltip="EUR/AUD, EUR/GBP ...: first option (the chart price itself is the EUR rate).\nGBP/USD, AUD/USD, USD/JPY ...: the certificate is converted at EUR/USD (EUR/JPY ...), NOT at the chart price. Use 'Live rate' with e.g. FX:EURUSD, or a fixed rate.\nUnderlying already in EUR (DAX, Bund ...): last option.")
fxSym      = input.symbol("FX:EURUSD", "Live rate: symbol", group=G2, tooltip="Symbol that quotes XXX per 1 EUR, e.g. FX:EURUSD for a GBP/USD certificate (USD per EUR).")
fxInv      = input.bool(false, "Live rate: invert (symbol quotes EUR per 1 XXX)", group=G2, tooltip="Tick if the symbol is XXX/EUR, e.g. a GBPEUR-type symbol.")
fxFixed    = input.float(1.0, "Fixed rate (XXX per 1 EUR)", minval=0.000001, group=G2)
spreadE    = input.float(0.01, "Spread Bid/Ask (EUR)", minval=0.0, step=0.001, group=G2)
askManual  = input.float(0.0, "Ask price override (EUR, 0 = use formula)", minval=0.0, step=0.001, group=G2, tooltip="Optional. If set, it is used as the purchase price and all other certificate prices are shifted by the same difference to the formula.")
feeE       = input.float(0.0, "Fee per order (EUR)", minval=0.0, step=0.1, group=G2)
askTol     = input.float(0.05, "Warning tolerance: Ask vs formula (EUR)", minval=0.0, step=0.01, group=G2, tooltip="The orange warning appears when your Ask override differs from the formula price by more than this. Differences of a few cents are normal (timing, data source, issuer margin).")

// ── 3. Risk ─────────────────────────────────────────────────────
account    = input.float(10000.0, "Account size (EUR)", minval=1.0, group=G3)
riskPct    = input.float(1.0, "Max loss (% of account)", minval=0.01, maxval=100.0, step=0.1, group=G3)
budget     = input.float(1000.0, "Max investment in the certificate (EUR, 0 = no limit)", minval=0.0, group=G3)

// ── 4. Display ──────────────────────────────────────────────────
wBars      = input.int(25, "Width of position box (bars)", minval=5, maxval=200, group=G4)
posStr     = input.string("Top right", "Table position", options=["Top left", "Top center", "Top right", "Middle left", "Middle center", "Middle right", "Bottom left", "Bottom center", "Bottom right"], group=G4)
themeStr   = input.string("Dark", "Color theme", options=["Dark", "Light"], group=G4)
sizeStr    = input.string("Small", "Table text size", options=["Tiny", "Small", "Normal"], group=G4)
transp     = input.int(5, "Table background transparency (0-100)", minval=0, maxval=100, group=G4)

// ════════════════════ Helpers ════════════════════
isLong     = str.startswith(dirStr, "Long") ? true : (str.startswith(dirStr, "Short") ? false : tpP >= entryP)
autoStopOn = str.startswith(stopMode, "Auto")
strikeEff  = sameStr ? koLvl : strikeIn
fxUnder    = str.startswith(fxMode, "Underlying")
fxFixedOn  = str.startswith(fxMode, "Fixed")
fxLiveOn   = str.startswith(fxMode, "Live")

fxRaw      = request.security(fxSym, timeframe.period, close, ignore_invalid_symbol=true)
fxLive     = na(fxRaw) ? fxFixed : (fxInv ? 1.0 / fxRaw : fxRaw)

f_div(float s) =>
    fxUnder ? s : (fxLiveOn ? fxLive : (fxFixedOn ? fxFixed : 1.0))

f_theo(float s) =>
    math.max(0.0, (isLong ? s - strikeEff : strikeEff - s) * mult / f_div(s))

f_p(float v)  => str.tostring(v, format.mintick)
f_e(float v)  => str.tostring(v, "0.00") + " €"
f_o(float v)  => str.tostring(v, "0.000") + " €"
f_pc(float v) => str.tostring(v, "0.00") + "%"

// ════════════════════ Calculation ════════════════════
maxLoss    = account * riskPct / 100.0

theoEntry  = f_theo(entryP)
askCalc    = theoEntry + spreadE / 2.0
entryCost  = askManual > 0 ? askManual : askCalc
offset     = askManual > 0 ? askManual - askCalc : 0.0

// Auto stop: underlying level at which the loss on the full budget equals max loss
nBudAuto    = (budget > 0 and entryCost > 0) ? math.floor(budget / entryCost) : 0
allowedLoss = nBudAuto > 0 ? (maxLoss - 2.0 * feeE) / nBudAuto : na
xTheo       = entryCost - allowedLoss - offset + spreadE / 2.0   // theoretical certificate value at the stop
fxVal       = fxLiveOn ? fxLive : (fxFixedOn ? fxFixed : 1.0)
autoStop    = float(na)
if not na(xTheo) and xTheo > 0
    if fxUnder
        autoStop := isLong ? strikeEff * mult / (mult - xTheo) : strikeEff * mult / (mult + xTheo)
    else
        autoStop := isLong ? strikeEff + xTheo * fxVal / mult : strikeEff - xTheo * fxVal / mult

stopP = autoStopOn ? autoStop : stopIn

ordOk = not na(stopP) and entryP > 0 and tpP > 0 and stopP > 0 and (isLong ? (tpP > entryP and entryP > stopP and stopP > koLvl) : (tpP < entryP and entryP < stopP and stopP < koLvl))

exitSL     = ordOk ? math.max(0.0, f_theo(stopP) + offset - spreadE / 2.0) : na
exitTP     = ordOk ? math.max(0.0, f_theo(tpP) + offset - spreadE / 2.0) : na
lossPer    = entryCost - exitSL
calcOk     = ordOk and entryCost > 0 and lossPer > 0

nRisk      = calcOk ? math.max(0, math.floor((maxLoss - 2.0 * feeE) / lossPer)) : 0
nBud       = calcOk ? (budget > 0 ? math.floor(budget / entryCost) : nRisk) : 0
nPcs       = math.min(nRisk, nBud)

invest     = nPcs * entryCost
lossEur    = nPcs * lossPer + 2.0 * feeE
profitEur  = nPcs * (exitTP - entryCost) - 2.0 * feeE
rr         = lossEur > 0 ? profitEur / lossEur : na
rrPrice    = ordOk ? math.abs(tpP - entryP) / math.abs(entryP - stopP) : na
lev        = entryCost > 0 ? mult * entryP / f_div(entryP) / entryCost : na

distStopPct  = ordOk ? (stopP - entryP) / entryP * 100.0 : na
distTpPct    = ordOk ? (tpP - entryP) / entryP * 100.0 : na
distKoPct    = (koLvl - entryP) / entryP * 100.0
stopOfKoPct  = ordOk ? math.abs(entryP - stopP) / math.abs(entryP - koLvl) * 100.0 : na
koBufferPct  = ordOk ? math.abs(stopP - koLvl) / stopP * 100.0 : na
atrV         = ta.atr(14)
stopAtr      = (ordOk and atrV > 0) ? math.abs(entryP - stopP) / atrV : na

// ── Live P&L (updates with every tick of the chart price) ──
nowP       = close
koHitNow   = isLong ? nowP <= koLvl : nowP >= koLvl
exitNow    = koHitNow ? 0.0 : math.max(0.0, f_theo(nowP) + offset - spreadE / 2.0)
pnlNow     = nPcs * (exitNow - entryCost) - 2.0 * feeE

// ════════════════════ Alerts ════════════════════
slTouch = ordOk and (isLong ? low <= stopP : high >= stopP)
tpTouch = ordOk and (isLong ? high >= tpP : low <= tpP)
koTouch = koLvl > 0 and (isLong ? low <= koLvl : high >= koLvl)
alertcondition(slTouch, "Stop level touched", "Underlying touched the stop level - close the certificate")
alertcondition(tpTouch, "Target level touched", "Underlying touched the target level")
alertcondition(koTouch, "Knock-Out barrier touched", "Underlying touched the knock-out barrier")

// ════════════════════ Look & feel ════════════════════
isDark  = themeStr == "Dark"
cBgBase = isDark ? #131722 : #FFFFFF
cBg     = color.new(cBgBase, transp)
cTxt    = isDark ? #D1D4DC : #131722
cDim    = isDark ? #9598A1 : #6A6D78
cStrong = isDark ? #FFFFFF : #000000
cFrame  = isDark ? #363A45 : #C8CBD3
cGreen  = isDark ? #26A69A : #089981
cRed    = isDark ? #EF5350 : #F23645
cBlue   = #2962FF
cOrange = isDark ? #FF9800 : #E65100
cOnOr   = isDark ? #000000 : #FFFFFF

tblPos = switch posStr
    "Top left"      => position.top_left
    "Top center"    => position.top_center
    "Middle left"   => position.middle_left
    "Middle center" => position.middle_center
    "Middle right"  => position.middle_right
    "Bottom left"   => position.bottom_left
    "Bottom center" => position.bottom_center
    "Bottom right"  => position.bottom_right
    => position.top_right

tSize = switch sizeStr
    "Tiny"   => size.tiny
    "Normal" => size.normal
    => size.small

f_sp(float v) => (v >= 0 ? "+" : "") + str.tostring(v, "0.00") + "%"
f_n3(float v) => str.tostring(v, "0.000")

// ════════════════════ Drawing ════════════════════
var table tbl = table.new(tblPos, 2, 26, bgcolor=cBg, frame_color=cFrame, frame_width=1, border_color=cFrame, border_width=1)
var line lnE = na
var line lnS = na
var line lnT = na
var line lnK = na
var label lbE = na
var label lbS = na
var label lbT = na
var label lbK = na
var box bxP = na
var box bxL = na

if barstate.isfirst
    table.merge_cells(tbl, 0, 19, 1, 19)
    table.merge_cells(tbl, 0, 20, 1, 20)

// two-column row
f_row(int r, string k, string v, color vc = na) =>
    table.cell(tbl, 0, r, k, text_color=cDim, text_halign=text.align_left, text_size=tSize, bgcolor=cBg)
    table.cell(tbl, 1, r, v, text_color=na(vc) ? cTxt : vc, text_halign=text.align_right, text_size=tSize, bgcolor=cBg)

// full-width (merged) row: rows 19 and 20 only
f_msg(int r, string t, color tc, color bg = na) =>
    table.cell(tbl, 0, r, t, text_color=tc, text_halign=text.align_center, text_size=tSize, bgcolor=na(bg) ? cBg : bg)

if barstate.islast
    // reset
    line.delete(lnE)
    line.delete(lnS)
    line.delete(lnT)
    line.delete(lnK)
    label.delete(lbE)
    label.delete(lbS)
    label.delete(lbT)
    label.delete(lbK)
    box.delete(bxP)
    box.delete(bxL)
    table.clear(tbl, 0, 0, 1, 25)

    dirTxt = isLong ? "LONG" : "SHORT"
    xL = math.max(0, bar_index - 30)
    xR = bar_index + wBars
    xB = bar_index

    if not ordOk
        table.cell(tbl, 0, 0, "SETUP ERROR", text_color=color.white, text_halign=text.align_left, text_size=tSize, bgcolor=cRed)
        table.cell(tbl, 1, 0, prodLbl, text_color=color.white, text_halign=text.align_right, text_size=tSize, bgcolor=cRed)
        f_row(1, "Entry", f_p(entryP))
        f_row(2, "Stop", na(stopP) ? "n/a" : f_p(stopP))
        f_row(3, "Target", f_p(tpP))
        f_row(4, "KO", f_p(koLvl))
        f_msg(19, "Order: " + (isLong ? "Target>Entry>Stop>KO" : "KO>Stop>Entry>Target"), cOrange)
        if (isLong and koLvl >= entryP) or (not isLong and koLvl <= entryP)
            f_msg(20, "KO on wrong side for " + dirTxt, cRed)
        else
            f_msg(20, "Drag the 3 dots / edit inputs", cDim)
        // keep the levels visible so the indicator can be selected and the dots dragged
        if entryP > 0
            lnE := line.new(xL, entryP, xR, entryP, color=cBlue, width=2)
            lbE := label.new(xR, entryP, "Entry " + f_p(entryP), xloc=xloc.bar_index, style=label.style_label_left, color=cBlue, textcolor=color.white, size=size.small)
        if stopIn > 0
            lnS := line.new(xL, stopIn, xR, stopIn, color=cRed, width=2)
            lbS := label.new(xR, stopIn, "Stop " + f_p(stopIn), xloc=xloc.bar_index, style=label.style_label_left, color=cRed, textcolor=color.white, size=size.small)
        if tpP > 0
            lnT := line.new(xL, tpP, xR, tpP, color=cGreen, width=2)
            lbT := label.new(xR, tpP, "Target " + f_p(tpP), xloc=xloc.bar_index, style=label.style_label_left, color=cGreen, textcolor=color.white, size=size.small)
        if koLvl > 0
            lnK := line.new(xL, koLvl, xR, koLvl, color=cOrange, width=1, style=line.style_dashed)
            lbK := label.new(xR, koLvl, "KO " + f_p(koLvl), xloc=xloc.bar_index, style=label.style_label_left, color=cOrange, textcolor=cOnOr, size=size.small)
    else
        table.cell(tbl, 0, 0, "KO CALC  |  " + dirTxt, text_color=color.white, text_halign=text.align_left, text_size=tSize, bgcolor=cBlue)
        table.cell(tbl, 1, 0, prodLbl, text_color=color.white, text_halign=text.align_right, text_size=tSize, bgcolor=cBlue)
        f_row(1, "Max loss", f_e(maxLoss) + " (" + str.tostring(riskPct, "0.0#") + "%)")
        f_row(2, "Entry", f_p(entryP))
        f_row(3, autoStopOn ? "Stop (auto)" : "Stop", f_p(stopP) + "  " + f_sp(distStopPct), cRed)
        f_row(4, "Target", f_p(tpP) + "  " + f_sp(distTpPct), cGreen)
        f_row(5, "KO", f_p(koLvl) + "  " + f_sp(distKoPct), cOrange)
        f_row(6, "Strike | FX", f_p(strikeEff) + " | " + str.tostring(f_div(entryP), "0.0000"))
        f_row(7, "Ask | formula", f_n3(entryCost) + " | " + f_n3(askCalc))
        f_row(8, "SL cert. (Bid)", f_o(exitSL), cRed)
        f_row(9, "TP cert. (Bid)", f_o(exitTP), cGreen)
        f_row(10, "PIECES", str.tostring(nPcs) + (nRisk <= nBud ? " (risk)" : " (budget)"), cStrong)
        f_row(11, "Invested", f_e(invest) + " (" + str.tostring(invest / account * 100.0, "0.0") + "%)")
        f_row(12, "Loss at SL", "-" + f_e(lossEur) + " (" + str.tostring(lossEur / account * 100.0, "0.0#") + "%)", cRed)
        f_row(13, "Profit at TP", "+" + f_e(profitEur), cGreen)
        f_row(14, "R:R net | price", (na(rr) ? "n/a" : str.tostring(rr, "0.00")) + " | " + (na(rrPrice) ? "n/a" : str.tostring(rrPrice, "0.00")))
        f_row(15, "Leverage", str.tostring(lev, "0.0") + "x")
        f_row(16, "SL → KO path", str.tostring(stopOfKoPct, "0") + "% (buf " + str.tostring(koBufferPct, "0.00") + "%)")
        f_row(17, "Stop in ATR(14)", na(stopAtr) ? "n/a" : str.tostring(stopAtr, "0.0#"), (not na(stopAtr) and stopAtr < 1.0) ? cOrange : na)
        f_row(18, "If KO / gap", "-" + f_e(invest + 2.0 * feeE), cOrange)
        if (fxLiveOn and na(fxRaw)) or (fxFixedOn and fxFixed == 1.0)
            f_msg(19, "⚠ FX rate = 1.0: check currency mode", cRed)
        else if exitSL <= 0.0005
            f_msg(19, "⚠ Stop beyond strike: SL = 0", cRed)
        else if math.abs(offset) > askTol
            f_msg(19, "⚠ Ask ≠ formula: check FX/Strike", cOrange)
        else if nPcs <= 0
            f_msg(19, "⚠ 0 pieces: stop too far / budget", cOrange)
        else if not na(stopAtr) and stopAtr < 1.0
            f_msg(19, "⚠ Stop < 1 ATR (noise risk)", cOrange)
        else
            f_msg(19, "Model price, no financing", cDim)

        // ── live position status ──
        cNow = pnlNow >= 0 ? cGreen : cRed
        f_msg(20, "LIVE", color.white, cBlue)
        f_row(21, "Now", f_p(nowP) + "  " + f_sp((nowP - entryP) / entryP * 100.0), cStrong)
        f_row(22, "Cert. now (Bid)", koHitNow ? "KNOCKED OUT" : f_o(exitNow), koHitNow ? cRed : na)
        f_row(23, "P&L now", (pnlNow >= 0 ? "+" : "") + f_e(pnlNow) + " (" + f_sp(invest > 0 ? pnlNow / invest * 100.0 : 0.0) + ")", cNow)
        f_row(24, pnlNow >= 0 ? "Of target" : "Of max loss", pnlNow >= 0 ? str.tostring(profitEur > 0 ? pnlNow / profitEur * 100.0 : 0.0, "0") + "%" : str.tostring(maxLoss > 0 ? -pnlNow / maxLoss * 100.0 : 0.0, "0") + "%", cNow)
        f_row(25, "To SL | TP", f_sp((stopP - nowP) / nowP * 100.0) + " | " + f_sp((tpP - nowP) / nowP * 100.0), cDim)

        // lines & labels
        lnE := line.new(xL, entryP, xR, entryP, color=cBlue, width=2)
        lnS := line.new(xL, stopP, xR, stopP, color=cRed, width=2)
        lnT := line.new(xL, tpP, xR, tpP, color=cGreen, width=2)
        lnK := line.new(xL, koLvl, xR, koLvl, color=cOrange, width=1, style=line.style_dashed)
        bxP := box.new(xB, math.max(entryP, tpP), xR, math.min(entryP, tpP), border_color=na, bgcolor=color.new(cGreen, 85))
        bxL := box.new(xB, math.max(entryP, stopP), xR, math.min(entryP, stopP), border_color=na, bgcolor=color.new(cRed, 85))
        lbE := label.new(xR, entryP, "Entry " + f_p(entryP) + " | " + str.tostring(nPcs) + " pcs @ " + f_o(entryCost), xloc=xloc.bar_index, style=label.style_label_left, color=cBlue, textcolor=color.white, size=size.small)
        lbS := label.new(xR, stopP, "SL " + f_p(stopP) + " | cert. " + f_o(exitSL) + " | -" + f_e(lossEur), xloc=xloc.bar_index, style=label.style_label_left, color=cRed, textcolor=color.white, size=size.small)
        lbT := label.new(xR, tpP, "TP " + f_p(tpP) + " | cert. " + f_o(exitTP) + " | +" + f_e(profitEur), xloc=xloc.bar_index, style=label.style_label_left, color=cGreen, textcolor=color.white, size=size.small)
        lbK := label.new(xR, koLvl, "KO " + f_p(koLvl), xloc=xloc.bar_index, style=label.style_label_left, color=cOrange, textcolor=cOnOr, size=size.small)
